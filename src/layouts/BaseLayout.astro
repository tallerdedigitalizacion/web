---
import { siteConfig } from "@/config/site";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import CookieBanner from "@/components/CookieBanner.astro";
import Chatbase from "@/components/Chatbase.astro";
import WhatsAppButton from "@/components/WhatsAppButton.astro";
import { withBase } from "@/utils/paths";
import { consentMaxAgeMs, consentStorageKey, consentVersion } from "@/config/consent";
import { canonicalOverrides, languagePairs, normalizePath } from "@/config/seoRoutes.mjs";
import "@/styles/global.css";

const {
  title = siteConfig.seoTitle,
  description = siteConfig.seoDescription,
  canonicalPath = "/",
  showChatbase = true,
  // Página sin cabecera, pie ni botones flotantes (por ejemplo, /hub).
  minimal = false,
  noindex = false,
  // Imagen al compartir en redes (1200×630). Por defecto, la de la marca.
  ogImage: ogImageProp = siteConfig.ogImage,
  ogImageAlt,
  showWhatsAppButton,
  headerBookingEvent = "reservar_click",
  headerNavItems = [],
  showHeaderBooking = true,
  lang = "es",
  bookingHref = lang === "en" ? siteConfig.bookingUrlEn : siteConfig.bookingUrl,
  schemaDescription = lang === "en"
    ? "Remote IT support, websites and digitalization for small businesses."
    : "Soporte informático, webs y digitalización para PyMEs en Toledo y alrededores de Fuensalida, presencial o en remoto.",
  schemaAreaServed = lang === "en" ? ["Remote"] : siteConfig.serviceAreas,
  alternates: alternatesProp = [],
  faq = [],
  extraSchema = [],
} = Astro.props;

const gaId = siteConfig.googleAnalyticsId;
const hasGoogleTag = Boolean(gaId) && !gaId.includes("INSERTAR");

const overriddenCanonical =canonicalOverrides[normalizePath(canonicalPath)];
const effectiveCanonicalPath = overriddenCanonical ?? canonicalPath;
const pair = languagePairs.find(([es, en]) => [es, en].includes(normalizePath(effectiveCanonicalPath)));
const alternates: [string, string][] =
  overriddenCanonical ? [] : alternatesProp.length > 0 ? alternatesProp : pair ? [["es-ES", pair[0]], ["en", pair[1]], ["x-default", pair[0]]] : [];

// Enlace al otro idioma en la cabecera: la página equivalente si existe; si no, la portada del otro idioma.
const langSwitchPath = pair ? (lang === "en" ? pair[0] : pair[1]) : lang === "en" ? "/" : "/en";
const langSwitchHref = langSwitchPath.endsWith("/") ? langSwitchPath : `${langSwitchPath}/`;

const origin = Astro.site ?? new URL(siteConfig.publicUrl).origin;
const absoluteUrl = (path: string) => new URL(withBase(path), origin).toString();
// GitHub Pages sirve cada página como carpeta y redirige (301) las URLs sin barra final.
const pageUrl = (path: string) => absoluteUrl(/\/$|\.[a-z0-9]+$/i.test(path) ? path : `${path}/`);
const canonical = pageUrl(effectiveCanonicalPath);
const ogImage = absoluteUrl(ogImageProp);
const businessId = `${siteConfig.publicUrl}/#business`;
const founderId = `${siteConfig.publicUrl}/#founder`;
const isEnglish = lang === "en";
// La versión en inglés se presenta como servicio 100 % remoto: sin dirección, coordenadas, horario ni radio presencial.
const localBusinessFields = isEnglish
  ? {
      areaServed: schemaAreaServed.map((name: string) => ({ "@type": "Place", name })),
    }
  : {
      telephone: siteConfig.phone,
      address: { "@type": "PostalAddress", ...siteConfig.address },
      geo: { "@type": "GeoCoordinates", ...siteConfig.geo },
      hasMap: siteConfig.googleBusinessUrl,
      openingHoursSpecification: siteConfig.openingHours.map(({ days, opens, closes }) => ({
        "@type": "OpeningHoursSpecification",
        dayOfWeek: days,
        opens,
        closes,
      })),
      areaServed: [
        ...schemaAreaServed.map((name: string) => ({ "@type": "Place", name })),
        {
          "@type": "GeoCircle",
          geoMidpoint: { "@type": "GeoCoordinates", ...siteConfig.geo },
          geoRadius: siteConfig.serviceRadiusKm * 1000,
        },
      ],
    };
const knowsAbout = isEnglish
  ? [
      "IT support for businesses",
      "IT maintenance",
      "Small business digitalization",
      "Google Workspace",
      "Website speed optimization",
      "Process automation",
      "AI agents for customer support",
    ]
  : [
      "Soporte informático para empresas",
      "Mantenimiento informático",
      "Digitalización de PyMEs",
      "Google Workspace",
      "Optimización de velocidad web",
      "Automatización de procesos",
      "Agentes de IA para atención al cliente",
    ];
const schemaGraph: Record<string, unknown>[] = [
  {
    "@type": "ProfessionalService",
    "@id": businessId,
    name: siteConfig.name,
    description: schemaDescription,
    url: siteConfig.publicUrl,
    logo: absoluteUrl(siteConfig.logo),
    image: ogImage,
    email: siteConfig.contactEmail,
    ...localBusinessFields,
    founder: { "@id": founderId },
    sameAs: [
      siteConfig.googleBusinessUrl,
      siteConfig.githubUrl,
      siteConfig.linkedinUrl,
      siteConfig.linkedinCompanyUrl,
      siteConfig.instagramUrl,
      siteConfig.youtubeUrl,
      siteConfig.tiktokUrl,
      siteConfig.facebookUrl,
    ],
    knowsAbout,
  },
  {
    "@type": "Person",
    "@id": founderId,
    name: siteConfig.founder,
    jobTitle: isEnglish ? "Digitalization consultant and IT support" : "Consultor de digitalización y soporte IT",
    worksFor: { "@id": businessId },
    url: siteConfig.publicUrl,
    sameAs: [siteConfig.linkedinUrl],
  },
  {
    "@type": "WebSite",
    "@id": `${siteConfig.publicUrl}/#website`,
    name: siteConfig.name,
    url: siteConfig.publicUrl,
    inLanguage: isEnglish ? "en" : "es-ES",
    publisher: { "@id": businessId },
  },
];
if (faq.length > 0) {
  schemaGraph.push({
    "@type": "FAQPage",
    mainEntity: faq.map(([question, answer]: [string, string]) => ({
      "@type": "Question",
      name: question,
      acceptedAnswer: { "@type": "Answer", text: answer },
    })),
  });
}
schemaGraph.push(...extraSchema);
const schema = { "@context": "https://schema.org", "@graph": schemaGraph };
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    {
      hasGoogleTag && (
        <>
          {/* Consent Mode v2. Va lo primero del <head>: el consentimiento por defecto se declara ANTES de cargar gtag.js.
              Todo denegado hasta que el visitante decide; si ya decidió en una visita anterior, se aplica enseguida,
              antes del primer evento. El banner (CookieBanner.astro) actualiza el estado cuando el visitante cambia. */}
          <script
            is:inline
            define:vars={{ gaId, consentKey: consentStorageKey, consentVersion, consentMaxAgeMs }}
          >
            window.dataLayer = window.dataLayer || [];
            window.gtag = function gtag() {
              window.dataLayer.push(arguments);
            };
            window.tdGoogleConsent = function tdGoogleConsent(consent) {
              window.gtag("consent", "update", {
                analytics_storage: consent && consent.analytics ? "granted" : "denied",
                ad_storage: consent && consent.marketing ? "granted" : "denied",
                ad_user_data: consent && consent.marketing ? "granted" : "denied",
                ad_personalization: consent && consent.marketing ? "granted" : "denied",
              });
            };
            window.gtag("consent", "default", {
              ad_storage: "denied",
              ad_user_data: "denied",
              ad_personalization: "denied",
              analytics_storage: "denied",
              wait_for_update: 500,
            });
            window.gtag("set", "ads_data_redaction", true);
            window.gtag("set", "url_passthrough", true);
            try {
              var raw = localStorage.getItem(consentKey);
              var stored = raw && raw.charAt(0) === "{" ? JSON.parse(raw) : null;
              if (stored && stored.version === consentVersion && Date.now() - Number(stored.date || 0) <= consentMaxAgeMs) {
                window.tdGoogleConsent(stored);
              }
            } catch (error) {
              // Sin almacenamiento: se queda el consentimiento por defecto (denegado).
            }
            window.gtag("js", new Date());
            window.gtag("config", gaId, { anonymize_ip: true });
          </script>
          <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
        </>
      )
    }

    <title>{title}</title>
    <meta name="description" content={description} />
    
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    {alternates.map(([hreflang, path]: [string, string]) => <link rel="alternate" hreflang={hreflang} href={pageUrl(path)} />)}
    
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === "en" ? "en_US" : "es_ES"} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {ogImageProp !== siteConfig.ogImage && <meta property="og:image:width" content="1200" />}
    {ogImageProp !== siteConfig.ogImage && <meta property="og:image:height" content="630" />}
    {ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {ogImageAlt && <meta name="twitter:image:alt" content={ogImageAlt} />}
    
    <meta name="msapplication-TileColor" content="#ffffff">
    <meta name="msapplication-TileImage" content="/ms-icon-144x144.png">
    <meta name="theme-color" content="#ffffff">
    <link rel="apple-touch-icon" sizes="57x57" href="/favicon/apple-icon-57x57.png">
    <link rel="apple-touch-icon" sizes="60x60" href="/favicon/apple-icon-60x60.png">
    <link rel="apple-touch-icon" sizes="72x72" href="/favicon/apple-icon-72x72.png">
    <link rel="apple-touch-icon" sizes="76x76" href="/favicon/apple-icon-76x76.png">
    <link rel="apple-touch-icon" sizes="114x114" href="/favicon/apple-icon-114x114.png">
    <link rel="apple-touch-icon" sizes="120x120" href="/favicon/apple-icon-120x120.png">
    <link rel="apple-touch-icon" sizes="144x144" href="/favicon/apple-icon-144x144.png">
    <link rel="apple-touch-icon" sizes="152x152" href="/favicon/apple-icon-152x152.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-icon-180x180.png">
    <link rel="icon" type="image/png" sizes="192x192"  href="/favicon/android-icon-192x192.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon/favicon-96x96.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon/favicon-16x16.png">
    <link rel="manifest" href="/favicon/manifest.json">

    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    {!minimal && <Header bookingEvent={headerBookingEvent} brandHref={lang === "en" ? "/en/" : "/"} navItems={headerNavItems} showBooking={showHeaderBooking} lang={lang} bookingHref={bookingHref} langSwitchHref={langSwitchHref} />}
    {/* Cabecera y pie propios de una página mínima (landings de campaña); vacíos en el resto. */}
    <slot name="header" />
    <main>
      <slot />
    </main>
    <slot name="footer" />
    {!minimal && <Footer lang={lang} />}
    <CookieBanner lang={lang} />
    {!minimal && (showWhatsAppButton ?? lang !== "en") && <WhatsAppButton lang={lang} />}
    {!minimal && showChatbase && <Chatbase />}
  </body>
</html>

---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { siteConfig } from "@/config/site";
import { reviews } from "@/data/reviews";

const title = "Diagnóstico de Digitalización para empresas | Taller de Digitalización";
const description = "Descubra dónde pierde tiempo, dinero y oportunidades. Auditoría técnica y funcional de sus procesos, con un informe priorizado y un plan de acción.";
const whatsappUrl = `https://wa.me/${siteConfig.whatsappNumber}?text=Hola,%20quiero%20un%20diagn%C3%B3stico%20de%20digitalizaci%C3%B3n`;
const googleReviewsUrl = "https://maps.app.goo.gl/iJYaupqoL8usLB6X7";

const analysisItems = [
  "Herramientas digitales utilizadas en la empresa",
  "Flujo de información entre departamentos",
  "Gestión de clientes y oportunidades comerciales",
  "Organización documental",
  "Automatizaciones existentes",
  "Procesos manuales repetitivos",
  "Uso de inteligencia artificial",
  "Integraciones entre plataformas",
  "Riesgos operativos y cuellos de botella",
];

const deliverables = [
  "Informe ejecutivo con los principales problemas detectados",
  "Mapa de procesos digitales",
  "Lista priorizada de mejoras",
  "Estimación del impacto de cada propuesta",
  "Recomendaciones técnicas adaptadas a su empresa",
  "Hoja de ruta para los siguientes 90 días",
];

const idealFor = [
  "Han crecido y sienten que todo empieza a ser caótico",
  "Trabajan con muchas hojas de cálculo y correos electrónicos",
  "Utilizan varias herramientas que no se comunican entre sí",
  "Quieren incorporar inteligencia artificial sin improvisar",
  "Desean ahorrar tiempo antes de contratar más personal",
];

const faqs = [
  ["¿Esto es lo mismo que el Diagnóstico de Caos Operativo?", "No. Ese analiza procesos y dependencia del dueño en la empresa. Este se centra en tu digitalización: herramientas, flujo de información, automatizaciones e integraciones entre plataformas."],
  ["¿Tengo que cambiarlo todo de golpe?", "No. Las recomendaciones se priorizan por impacto y esfuerzo, para que puedas implementarlas por fases."],
  ["¿Me vais a vender herramientas nuevas?", "No. El objetivo no es venderle software, sino ayudarle a tomar mejores decisiones tecnológicas."],
  ["¿Cuánto cuesta?", "El alcance y el precio se ajustan al tamaño y complejidad de la empresa. Sin compromiso hasta que decida seguir."],
];

const navItems = [
  ["Qué analizamos", "#que-analizamos"],
  ["Qué recibe", "#que-recibe"],
  ["Ideal para", "#ideal-para"],
  ["Por qué yo", "#por-que-yo"],
  ["FAQ", "#faq"],
];

const diagnosticoReviews = reviews.slice(0, 8);
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath="/diagnostico-digitalizacion"
  headerBrandHref="/diagnostico-digitalizacion"
  headerNavItems={navItems}
  headerBookingEvent="reservar_click"
  schemaDescription="Auditoría técnica y funcional de los procesos digitales de una empresa, con informe priorizado, mapa de procesos y plan de acción a 90 días."
>
  <section class="hero">
    <div class="hero-content">
      <span class="eyebrow">Diagnóstico de Digitalización</span>
      <h1>Descubra dónde pierde tiempo, dinero y oportunidades.</h1>
      <p class="hero-subtitle">La mayoría de las empresas no necesitan más herramientas. Necesitan entender qué tienen, cómo trabajan y qué está frenando su crecimiento.</p>
      <div class="hero-actions">
        <a class="btn btn-primary" data-event="reservar_click" data-preserve-utm href={siteConfig.bookingUrl} target="_blank" rel="noreferrer">Solicitar diagnóstico</a>
        <a class="btn btn-secondary" data-event="whatsapp_click" data-preserve-utm href={whatsappUrl} target="_blank" rel="noreferrer">
          <svg class="btn-icon" aria-hidden="true" viewBox="0 0 32 32" width="20" height="20">
            <path fill="currentColor" d="M16.02 3.2A12.66 12.66 0 0 0 5.1 22.28L3.6 28.8l6.66-1.56A12.65 12.65 0 1 0 16.02 3.2Zm0 22.9c-1.96 0-3.78-.56-5.34-1.54l-.38-.24-3.94.92.9-3.86-.25-.4a10.24 10.24 0 1 1 9.01 5.12Zm5.62-7.66c-.3-.16-1.82-.9-2.1-1-.28-.1-.48-.16-.68.16-.2.3-.78 1-.96 1.2-.18.2-.36.22-.66.08-.3-.16-1.28-.48-2.44-1.52-.9-.8-1.5-1.8-1.68-2.1-.18-.3-.02-.48.14-.64.14-.14.3-.36.46-.54.16-.18.2-.3.3-.5.1-.2.06-.38-.02-.54-.08-.16-.68-1.64-.94-2.24-.24-.58-.5-.5-.68-.5h-.58c-.2 0-.52.08-.8.38-.28.3-1.04 1.02-1.04 2.48s1.06 2.88 1.22 3.08c.16.2 2.1 3.2 5.08 4.48.7.3 1.26.48 1.7.62.72.22 1.36.2 1.88.12.58-.08 1.82-.74 2.08-1.46.26-.72.26-1.34.18-1.46-.08-.14-.28-.22-.58-.38Z"/>
          </svg>
          Escríbeme por WhatsApp
        </a>
      </div>
    </div>
  </section>

  <section id="que-hago" class="section section-split">
    <div>
      <span class="eyebrow">Qué hago</span>
      <h2>Una auditoría técnica y funcional de sus procesos.</h2>
      <p>Analizamos cómo circula la información, qué tareas son manuales, dónde existen duplicidades, qué herramientas no están integradas y qué oportunidades de automatización ofrecen un mayor retorno.</p>
      <p>Al finalizar recibirá un informe claro y priorizado, con recomendaciones prácticas y un plan de acción.</p>
    </div>
    <div class="honest-note">
      <span class="eyebrow">Sin vueltas</span>
      <p>Sin compromisos y sin necesidad de cambiar todo de golpe.</p>
    </div>
  </section>

  <section id="que-analizamos" class="section section-accent">
    <div class="section-head">
      <span class="eyebrow">¿Qué analizamos?</span>
      <h2>Un mapa completo de cómo trabaja su empresa hoy.</h2>
    </div>
    <div class="tag-grid">
      {analysisItems.map((item) => <span>{item}</span>)}
    </div>
  </section>

  <section id="que-recibe" class="section">
    <div class="section-head">
      <span class="eyebrow">¿Qué recibe?</span>
      <h2>Un informe, no una colección de opiniones.</h2>
    </div>
    <ul class="check-list">
      {deliverables.map((item) => <li>{item}</li>)}
    </ul>
  </section>

  <section id="ideal-para" class="section">
    <div class="section-head">
      <span class="eyebrow">Ideal para empresas que…</span>
      <h2>¿Le suena alguna de estas situaciones?</h2>
    </div>
    <ul class="check-list">
      {idealFor.map((item) => <li>{item}</li>)}
    </ul>
  </section>

  <section class="section callout">
    <span class="eyebrow">Nuestro objetivo</span>
    <h2>No venderle software. Ayudarle a tomar mejores decisiones tecnológicas.</h2>
    <p>Un buen diagnóstico suele descubrir pequeñas mejoras que generan un impacto inmediato, y también sirve como base para proyectos posteriores de automatización, integración de sistemas o inteligencia artificial.</p>
  </section>

  <section id="por-que-yo" class="section">
    <div class="section-head">
      <span class="eyebrow">Por qué yo</span>
      <h2>Una persona técnica mirando el problema de frente.</h2>
      <p>15 años desarrollando y optimizando software. <a class="google-review-link" href={googleReviewsUrl} target="_blank" rel="noreferrer">
        <svg class="google-mark" aria-hidden="true" viewBox="0 0 24 24" width="18" height="18">
          <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.76h3.56c2.08-1.92 3.28-4.74 3.28-8.09Z"/>
          <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.56-2.76c-.98.66-2.24 1.06-3.72 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84A11 11 0 0 0 12 23Z"/>
          <path fill="#FBBC05" d="M5.84 14.11a6.61 6.61 0 0 1 0-4.22V7.05H2.18a11 11 0 0 0 0 9.9l3.66-2.84Z"/>
          <path fill="#EA4335" d="M12 5.36c1.62 0 3.06.56 4.21 1.64l3.15-3.15A10.56 10.56 0 0 0 12 1 11 11 0 0 0 2.18 7.05l3.66 2.84C6.71 7.29 9.14 5.36 12 5.36Z"/>
        </svg>
        +10 reseñas en Google
      </a> y +1.000 seguidores en LinkedIn. Una persona real que te atiende, no una agencia que te deriva a un becario.</p>
    </div>
    <div class="reviews-carousel" data-reviews-carousel aria-label="Reseñas de Google">
      <div class="reviews-track" data-reviews-track>
        {diagnosticoReviews.map((review, index) => (
          <article class="review-card" data-review-card aria-label={`Reseña ${index + 1} de ${diagnosticoReviews.length}`}>
            <div class="review-meta">
              <strong>{review.name}</strong>
              <a class="review-source" href={googleReviewsUrl} target="_blank" rel="noreferrer">
                <svg class="google-mark" aria-hidden="true" viewBox="0 0 24 24" width="16" height="16">
                  <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.76h3.56c2.08-1.92 3.28-4.74 3.28-8.09Z"/>
                  <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.56-2.76c-.98.66-2.24 1.06-3.72 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84A11 11 0 0 0 12 23Z"/>
                  <path fill="#FBBC05" d="M5.84 14.11a6.61 6.61 0 0 1 0-4.22V7.05H2.18a11 11 0 0 0 0 9.9l3.66-2.84Z"/>
                  <path fill="#EA4335" d="M12 5.36c1.62 0 3.06.56 4.21 1.64l3.15-3.15A10.56 10.56 0 0 0 12 1 11 11 0 0 0 2.18 7.05l3.66 2.84C6.71 7.29 9.14 5.36 12 5.36Z"/>
                </svg>
                {review.source} · {review.rating}/5 · {review.date}
              </a>
            </div>
            <p>{review.text}</p>
          </article>
        ))}
      </div>
      <div class="carousel-controls">
        <button class="btn btn-secondary btn-small" type="button" data-review-prev aria-label="Ver reseña anterior">Anterior</button>
        <div class="carousel-dots" data-review-dots aria-label="Indicador de reseñas"></div>
        <button class="btn btn-secondary btn-small" type="button" data-review-next aria-label="Ver reseña siguiente">Siguiente</button>
      </div>
    </div>
  </section>

  <section id="faq" class="section">
    <div class="section-head">
      <span class="eyebrow">Preguntas frecuentes</span>
      <h2>Dudas habituales antes del diagnóstico.</h2>
    </div>
    <div class="faq-list">
      {faqs.map(([question, answer]) => (
        <details>
          <summary>{question}</summary>
          <p>{answer}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="section final-cta">
    <h2>Solicite un Diagnóstico de Digitalización y descubra qué mejoras pueden generar el mayor retorno con la menor inversión.</h2>
    <div class="hero-actions">
      <a class="btn btn-primary" data-event="reservar_click" data-preserve-utm href={siteConfig.bookingUrl} target="_blank" rel="noreferrer">Solicitar diagnóstico</a>
      <a class="btn btn-secondary" data-event="whatsapp_click" data-preserve-utm href={whatsappUrl} target="_blank" rel="noreferrer">
        <svg class="btn-icon" aria-hidden="true" viewBox="0 0 32 32" width="20" height="20">
          <path fill="currentColor" d="M16.02 3.2A12.66 12.66 0 0 0 5.1 22.28L3.6 28.8l6.66-1.56A12.65 12.65 0 1 0 16.02 3.2Zm0 22.9c-1.96 0-3.78-.56-5.34-1.54l-.38-.24-3.94.92.9-3.86-.25-.4a10.24 10.24 0 1 1 9.01 5.12Zm5.62-7.66c-.3-.16-1.82-.9-2.1-1-.28-.1-.48-.16-.68.16-.2.3-.78 1-.96 1.2-.18.2-.36.22-.66.08-.3-.16-1.28-.48-2.44-1.52-.9-.8-1.5-1.8-1.68-2.1-.18-.3-.02-.48.14-.64.14-.14.3-.36.46-.54.16-.18.2-.3.3-.5.1-.2.06-.38-.02-.54-.08-.16-.68-1.64-.94-2.24-.24-.58-.5-.5-.68-.5h-.58c-.2 0-.52.08-.8.38-.28.3-1.04 1.02-1.04 2.48s1.06 2.88 1.22 3.08c.16.2 2.1 3.2 5.08 4.48.7.3 1.26.48 1.7.62.72.22 1.36.2 1.88.12.58-.08 1.82-.74 2.08-1.46.26-.72.26-1.34.18-1.46-.08-.14-.28-.22-.58-.38Z"/>
        </svg>
        Escríbeme por WhatsApp
      </a>
    </div>
  </section>
</BaseLayout>

<script>
  const params = new URLSearchParams(window.location.search);
  const utmEntries = [...params.entries()].filter(([key]) => key.toLowerCase().startsWith("utm_"));

  if (utmEntries.length > 0) {
    document.querySelectorAll('[data-preserve-utm], a[href*="calendly.com/tallerdedigitalizacion"]').forEach((link) => {
      if (!(link instanceof HTMLAnchorElement)) return;
      const url = new URL(link.href);
      utmEntries.forEach(([key, value]) => {
        if (!url.searchParams.has(key)) url.searchParams.set(key, value);
      });
      link.href = url.toString();
    });
  }

  document.querySelectorAll(".faq-list details").forEach((item) => {
    item.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      if (target.closest("summary")) return;
      item.open = !item.open;
    });
  });

  const carousel = document.querySelector("[data-reviews-carousel]");
  const track = document.querySelector("[data-reviews-track]");
  const cards = [...document.querySelectorAll("[data-review-card]")];
  const prev = document.querySelector("[data-review-prev]");
  const next = document.querySelector("[data-review-next]");
  const dots = document.querySelector("[data-review-dots]");
  let activeReview = 0;
  let scrollTimer;

  function renderDots() {
    if (!(dots instanceof HTMLElement)) return;
    dots.innerHTML = cards
      .map((_, index) => `<button type="button" aria-label="Ver reseña ${index + 1}" data-review-dot="${index}"></button>`)
      .join("");
  }

  function setActiveReview(index) {
    activeReview = (index + cards.length) % cards.length;
    dots?.querySelectorAll("[data-review-dot]").forEach((dot) => {
      dot.toggleAttribute("aria-current", dot.getAttribute("data-review-dot") === String(activeReview));
    });
  }

  function showReview(index) {
    if (!(track instanceof HTMLElement) || cards.length === 0) return;
    setActiveReview(index);
    const card = cards[activeReview];
    track.scrollTo({ left: card.offsetLeft - track.offsetLeft, behavior: "smooth" });
  }

  function syncReviewFromScroll() {
    if (!(track instanceof HTMLElement) || cards.length === 0) return;
    const nearestIndex = cards.reduce((nearest, card, index) => {
      const currentDistance = Math.abs(card.getBoundingClientRect().left - track.getBoundingClientRect().left);
      const nearestDistance = Math.abs(cards[nearest].getBoundingClientRect().left - track.getBoundingClientRect().left);
      return currentDistance < nearestDistance ? index : nearest;
    }, 0);
    setActiveReview(nearestIndex);
  }

  if (carousel && track && cards.length) {
    renderDots();
    showReview(0);

    track.addEventListener("scroll", () => {
      window.clearTimeout(scrollTimer);
      scrollTimer = window.setTimeout(syncReviewFromScroll, 80);
    });
    prev?.addEventListener("click", () => showReview(activeReview - 1));
    next?.addEventListener("click", () => showReview(activeReview + 1));
    dots?.addEventListener("click", (event) => {
      const dot = event.target instanceof Element ? event.target.closest("[data-review-dot]") : null;
      if (dot instanceof HTMLElement) showReview(Number(dot.dataset.reviewDot));
    });
  }
</script>

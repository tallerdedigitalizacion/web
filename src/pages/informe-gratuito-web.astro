---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { siteConfig } from "@/config/site";

const title = "Informe Gratuito de su Página Web | Taller de Digitalización";
const description = "Descubra qué está frenando el rendimiento de su web en menos de 2 minutos. Introduzca su URL y reciba un informe gratuito por email.";

const analysisItems = [
  "Rendimiento y velocidad de carga",
  "Optimización para dispositivos móviles",
  "Aspectos básicos de SEO",
  "Seguridad y configuración HTTPS",
  "Calidad de los formularios de contacto",
  "Captación de leads",
  "Experiencia de usuario",
  "Oportunidades de automatización e inteligencia artificial",
];

const deliverables = [
  "Un informe personalizado",
  "Los principales problemas detectados",
  "Recomendaciones claras y priorizadas",
  "Acciones rápidas que puede aplicar",
  "Oportunidades para mejorar la captación de clientes",
];

const steps = [
  "Introduzca la URL de su página web",
  "Analizamos automáticamente los principales indicadores",
  "Reciba su informe directamente en su correo electrónico",
];

const idealFor = [
  "Quiere saber si su web está funcionando correctamente",
  "Ha invertido en una página web y desconoce si está dando resultados",
  "Está pensando en renovar su presencia digital",
  "Quiere detectar oportunidades antes que su competencia",
];

const navItems = [
  ["Qué analizamos", "#que-analizamos"],
  ["Qué recibirá", "#que-recibira"],
  ["Cómo funciona", "#como-funciona"],
  ["Ideal si", "#ideal-si"],
];
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath="/informe-gratuito-web"
  headerBrandHref="/informe-gratuito-web"
  headerNavItems={navItems}
  showHeaderBooking={false}
  schemaDescription="Informe automático y gratuito sobre el rendimiento, SEO básico, seguridad y captación de leads de una página web."
>
  <section class="hero">
    <div class="hero-content">
      <span class="eyebrow">Informe Gratuito de su Página Web</span>
      <h1>Descubra qué está frenando el rendimiento de su web en menos de 2 minutos.</h1>
      <p class="hero-subtitle">Su página web puede estar perdiendo clientes sin que usted lo sepa. Un formulario que no convierte, una carga lenta o una mala estructura pueden hacer que los usuarios abandonen antes de contactar con su empresa.</p>
      <p>Introduzca la dirección de su página web y recibirá un informe gratuito con los principales aspectos que afectan a su presencia digital.</p>
    </div>

    <div class="lead-capture" data-report-form-wrapper>
      <form class="compact-form" data-report-form>
        <label>Dirección de su página web<input required type="url" name="url" placeholder="https://www.suempresa.com" autocomplete="url" /></label>
        <label>Correo electrónico<input required type="email" name="email" placeholder="usted@suempresa.com" autocomplete="email" /><small>Le enviaremos el informe a este email.</small></label>
        <label class="honeypot" aria-hidden="true">Web<input tabindex="-1" autocomplete="off" name="website" /></label>
        <input type="hidden" name="started_at" data-started-at />
        <button class="btn btn-primary" type="submit" data-event="informe_web_click">Solicitar informe gratuito</button>
        <p class="form-help" data-report-status aria-live="polite"></p>
      </form>
    </div>

    <div class="result-panel" data-report-result hidden aria-live="polite">
      <div class="result-summary">
        <div>
          <span class="eyebrow">Análisis completado</span>
          <h3 data-report-title></h3>
          <ul data-report-findings></ul>
          <p class="muted">Este informe se basa en indicadores automáticos y es una primera lectura, no un diagnóstico completo.</p>
        </div>
      </div>
      <div class="result-actions">
        <a class="btn btn-primary" data-event="reservar_click" href={siteConfig.bookingUrl} target="_blank" rel="noreferrer">Reservar llamada para revisar mi web</a>
        <button class="btn btn-secondary" type="button" data-report-reset>Analizar otra web</button>
      </div>
    </div>
  </section>

  <section id="que-analizamos" class="section section-accent">
    <div class="section-head">
      <span class="eyebrow">¿Qué analizamos?</span>
      <h2>Los indicadores que más afectan a su presencia digital.</h2>
    </div>
    <div class="tag-grid">
      {analysisItems.map((item) => <span>{item}</span>)}
    </div>
  </section>

  <section id="que-recibira" class="section">
    <div class="section-head">
      <span class="eyebrow">¿Qué recibirá?</span>
      <h2>Un informe accionable, no una lista de tecnicismos.</h2>
    </div>
    <ul class="check-list">
      {deliverables.map((item) => <li>{item}</li>)}
    </ul>
  </section>

  <section id="como-funciona" class="section section-accent">
    <div class="section-head">
      <span class="eyebrow">¿Cómo funciona?</span>
      <h2>3 pasos, sin vueltas.</h2>
    </div>
    <div class="steps">
      {steps.map((step, index) => (
        <article>
          <span class="step-number">{index + 1}</span>
          <h3>{step}</h3>
        </article>
      ))}
    </div>
  </section>

  <section id="ideal-si" class="section">
    <div class="section-head">
      <span class="eyebrow">Este informe es ideal si…</span>
      <h2>¿Le suena alguna de estas situaciones?</h2>
    </div>
    <ul class="check-list">
      {idealFor.map((item) => <li>{item}</li>)}
    </ul>
  </section>

  <section class="section final-cta">
    <h2>Empiece hoy mismo. Descubra el potencial de su página web antes de invertir más tiempo o dinero.</h2>
    <p>Solo necesita introducir la dirección de su página web y un correo electrónico. En unos minutos recibirá un análisis con las principales oportunidades de mejora.</p>
    <div class="hero-actions">
      <a class="btn btn-primary" href="#top" data-scroll-to-form>Solicitar informe gratuito</a>
    </div>
  </section>
</BaseLayout>

<script define:vars={{ formEndpoint: siteConfig.formEndpoint }}>
  function apiBaseUrl() {
    if (!formEndpoint || formEndpoint.includes("INSERTAR")) return "";
    return String(formEndpoint).replace(/\/$/, "");
  }

  async function postLead(path, payload) {
    const baseUrl = apiBaseUrl();
    if (!baseUrl) throw new Error("Endpoint de formularios no configurado.");
    const response = await fetch(`${baseUrl}/lead/${path}`, {
      method: "POST",
      headers: { "content-type": "application/json" },
      body: JSON.stringify(payload),
    });
    const data = await response.json().catch(() => ({}));
    if (!response.ok || data.ok === false) {
      throw new Error(data.error || "No se pudo procesar la solicitud.");
    }
    return data;
  }

  const form = document.querySelector("[data-report-form]");
  const formWrapper = document.querySelector("[data-report-form-wrapper]");
  const result = document.querySelector("[data-report-result]");

  document.querySelectorAll("[data-started-at]").forEach((input) => {
    if (input instanceof HTMLInputElement) input.value = String(Date.now());
  });

  document.querySelectorAll("[data-scroll-to-form]").forEach((link) => {
    link.addEventListener("click", (event) => {
      event.preventDefault();
      formWrapper?.scrollIntoView({ behavior: "smooth", block: "center" });
    });
  });

  if (form instanceof HTMLFormElement) {
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const button = form.querySelector("button[type='submit']");
      const status = document.querySelector("[data-report-status]");
      if (button instanceof HTMLButtonElement) button.disabled = true;
      if (status instanceof HTMLElement) status.textContent = "Analizando su página web...";

      const formData = new FormData(form);
      try {
        const response = await postLead("website-report", {
          url: String(formData.get("url") || ""),
          email: String(formData.get("email") || ""),
          website: String(formData.get("website") || ""),
          startedAt: Number(formData.get("started_at") || Date.now()),
          pageUrl: window.location.href,
          userAgent: navigator.userAgent,
        });

        const title = document.querySelector("[data-report-title]");
        const findingsList = document.querySelector("[data-report-findings]");
        if (title instanceof HTMLElement) {
          title.textContent = response.emailDelivered === false ? "Analizamos tu web." : "Te enviamos el informe por email.";
        }
        if (findingsList instanceof HTMLElement) {
          findingsList.innerHTML = "";
          const findings = Array.isArray(response.findings) ? response.findings : [];
          findings.forEach((finding) => {
            const li = document.createElement("li");
            li.textContent = finding;
            findingsList.appendChild(li);
          });
        }

        form.hidden = true;
        if (result instanceof HTMLElement) result.hidden = false;
        result?.scrollIntoView({ behavior: "smooth", block: "start" });
        window.tdTrackEvent?.("informe_web_completado");
      } catch (error) {
        if (status instanceof HTMLElement) status.textContent = error instanceof Error ? error.message : "No se pudo analizar la web.";
        if (button instanceof HTMLButtonElement) button.disabled = false;
      }
    });
  }

  document.querySelector("[data-report-reset]")?.addEventListener("click", () => {
    if (!(form instanceof HTMLFormElement)) return;
    form.reset();
    form.hidden = false;
    if (result instanceof HTMLElement) result.hidden = true;
    const button = form.querySelector("button[type='submit']");
    if (button instanceof HTMLButtonElement) button.disabled = false;
    document.querySelectorAll("[data-started-at]").forEach((input) => {
      if (input instanceof HTMLInputElement) input.value = String(Date.now());
    });
    formWrapper?.scrollIntoView({ behavior: "smooth", block: "center" });
  });
</script>

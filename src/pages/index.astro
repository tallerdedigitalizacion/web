---
import BaseLayout from "@/layouts/BaseLayout.astro";

const title = "Taller de Digitalización | Soluciones técnicas para negocios";
const description = "Taller de Digitalización reúne servicios técnicos para resolver problemas concretos de negocio: presencia online, captación web, caos operativo, IA interna y velocidad web.";

const products = [
  {
    eyebrow: "Soporte IA",
    title: "Agente de soporte al cliente IA",
    text: "Para pequeñas empresas que reciben muchas preguntas repetidas y quieren responder mejor sin contratar más personal.",
    href: "/agente-soporte-cliente-ia",
    cta: "Ver agente de soporte IA",
  },
  {
    eyebrow: "Arranque digital",
    title: "Arranque digital para negocios",
    text: "Para autónomos, comercios y pequeños negocios que necesitan empezar a recibir clientes online con lo esencial bien configurado.",
    href: "/arranque-digital-negocios",
    cta: "Ver arranque digital",
  },
  {
    eyebrow: "Operaciones",
    title: "Diagnóstico de Caos Operativo",
    text: "Para PyMEs que funcionan, pero con demasiada dependencia del dueño, fricción interna y procesos poco claros.",
    href: "/diagnostico-caos-operativo",
    cta: "Ver diagnóstico operativo",
  },
  {
    eyebrow: "IA interna",
    title: "Agente Oráculo IA Interno",
    text: "Para negocios con información dispersa que quieren convertir procesos, FAQs y documentación en un asistente interno consultable.",
    href: "/agente-oraculo-ia-interno",
    cta: "Ver oráculo IA",
  },
  {
    eyebrow: "Velocidad web",
    title: "Optimización de velocidad web",
    text: "Para webs lentas que pierden visitas, posicionamiento y contactos antes de que el cliente vea la oferta.",
    href: "/optimizacion-velocidad-web",
    cta: "Ver optimización de velocidad",
  },
  {
    eyebrow: "Auditoría web",
    title: "Auditoría Web Técnica",
    text: "Para negocios que reciben visitas pero quieren saber si la web está perdiendo leads por velocidad, formularios, seguridad o infraestructura.",
    href: "/auditoria-web",
    cta: "Ver auditoría web",
  },
];
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath="/"
  showHeaderBooking={false}
  headerNavItems={[["Productos", "#productos"]]}
  alternateLinks={[
    { lang: "es", path: "/" },
    { lang: "en", path: "/en/" },
    { lang: "x-default", path: "/" },
  ]}
>
  <section class="hero home-hero">
    <div class="hero-content">
      <span class="eyebrow">Taller de Digitalización</span>
      <h1>Soluciones técnicas para problemas concretos de negocio.</h1>
      <p class="hero-subtitle">Elige el problema que quieres resolver. Cada servicio tiene su propia página, su propio contexto y un único objetivo.</p>
    </div>
  </section>

  <section id="productos" class="section">
    <div class="section-head">
      <span class="eyebrow">Servicios</span>
      <h2>Seis dolores, seis caminos.</h2>
      <p>Esta página solo ordena la entrada. Las páginas de producto funcionan como funnels independientes, sin distracciones ni navegación cruzada.</p>
    </div>
    <div class="product-grid">
      {products.map((product) => (
        <article class="product-card">
          <span class="eyebrow">{product.eyebrow}</span>
          <h3>{product.title}</h3>
          <p>{product.text}</p>
          <a class="btn btn-primary" href={product.href}>{product.cta}</a>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>

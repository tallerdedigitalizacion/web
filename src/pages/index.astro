---
import BaseLayout from "@/layouts/BaseLayout.astro";

const title = "Taller de Digitalización | Soluciones técnicas para negocios";
const description = "Taller de Digitalización reúne servicios técnicos para resolver problemas concretos de negocio: digitalización, caos operativo y velocidad web.";

const products = [
  {
    eyebrow: "Digitalización",
    title: "Diagnóstico de Digitalización",
    text: "Descubra dónde pierde tiempo, dinero y oportunidades: una auditoría técnica y funcional de sus procesos, con informe priorizado y plan de acción.",
    href: "/diagnostico-digitalizacion",
    cta: "Ver diagnóstico de digitalización",
  },
  {
    eyebrow: "Google Workspace",
    title: "Reorganización de Google Workspace",
    text: "Ordenamos usuarios, licencias, grupos y permisos para que cada persona acceda solo a lo que necesita.",
    href: "/reorganizacion-google-workspace",
    cta: "Ver reorganización de Workspace",
  },
  {
    eyebrow: "Google Drive",
    title: "Reestructuración de Google Drive Corporativo",
    text: "Una estructura clara y escalable para encontrar cualquier documento en segundos.",
    href: "/reestructuracion-google-drive",
    cta: "Ver reestructuración de Drive",
  },
  {
    eyebrow: "Seguridad",
    title: "Gestión Centralizada de Accesos",
    text: "Sepa quién puede acceder a qué, con un gestor de contraseñas y procedimientos de alta y baja.",
    href: "/gestion-centralizada-accesos",
    cta: "Ver gestión de accesos",
  },
  {
    eyebrow: "Comercial",
    title: "Centralización de Leads",
    text: "Todos sus clientes potenciales en un único lugar, con seguimiento automático en su CRM.",
    href: "/centralizacion-leads",
    cta: "Ver centralización de leads",
  },
  {
    eyebrow: "Marketing",
    title: "Landing Pages de Conversión",
    text: "Páginas enfocadas en un único objetivo para convertir el tráfico de sus campañas en contactos.",
    href: "/landing-pages-conversion",
    cta: "Ver landing pages",
  },
  {
    eyebrow: "IA interna",
    title: "Oráculo Interno",
    text: "El conocimiento de su empresa disponible en segundos, respondido por IA sobre su propia documentación.",
    href: "/oraculo-interno",
    cta: "Ver Oráculo Interno",
  },
  {
    eyebrow: "IA externa",
    title: "Oráculo Externo",
    text: "Atienda a sus clientes 24/7 y capte nuevos leads con un asistente de IA sobre su información.",
    href: "/oraculo-externo",
    cta: "Ver Oráculo Externo",
  },
  {
    eyebrow: "Integraciones",
    title: "Integración de Sistemas",
    text: "Conectamos su CRM, ERP, facturación y demás herramientas para eliminar tareas manuales y errores.",
    href: "/integracion-sistemas",
    cta: "Ver integración de sistemas",
  },
  {
    eyebrow: "A medida",
    title: "Herramientas Internas a Medida",
    text: "Paneles, portales y automatizaciones a medida para simplificar el trabajo diario de su equipo.",
    href: "/herramientas-internas-medida",
    cta: "Ver herramientas a medida",
  },
  {
    eyebrow: "Web",
    title: "Informe Gratuito de su Página Web",
    text: "Introduzca su URL y reciba en minutos un informe gratuito sobre velocidad, SEO básico, seguridad y captación de leads.",
    href: "/informe-gratuito-web",
    cta: "Solicitar informe gratuito",
  },
  {
    eyebrow: "Operaciones",
    title: "Diagnóstico de Caos Operativo",
    text: "Para PyMEs que funcionan, pero con demasiada dependencia del dueño, fricción interna y procesos poco claros.",
    href: "/diagnostico-caos-operativo",
    cta: "Ver diagnóstico operativo",
  },
  {
    eyebrow: "Velocidad web",
    title: "Optimización de velocidad web",
    text: "Para webs lentas que pierden visitas, posicionamiento y contactos antes de que el cliente vea la oferta.",
    href: "/optimizacion-velocidad-web",
    cta: "Ver optimización de velocidad",
  },
];
---

<BaseLayout title={title} description={description} canonicalPath="/" showHeaderBooking={false} headerNavItems={[["Productos", "#productos"], ["English", "/en"]]}>
  <section class="hero home-hero">
    <div class="hero-content">
      <span class="eyebrow">Taller de Digitalización</span>
      <h1>Soluciones técnicas para problemas concretos de negocio.</h1>
      <p class="hero-subtitle">Elige el problema que quieres resolver. Cada servicio tiene su propia página, su propio contexto y un único objetivo.</p>
    </div>
  </section>

  <section id="productos" class="section">
    <div class="section-head">
      <span class="eyebrow">Servicios</span>
      <h2>Un catálogo de dolores, un camino cada uno.</h2>
      <p>Esta página solo ordena la entrada. Las páginas de producto funcionan como funnels independientes, sin distracciones ni navegación cruzada.</p>
    </div>
    <div class="product-grid">
      {products.map((product) => (
        <article class="product-card">
          <span class="eyebrow">{product.eyebrow}</span>
          <h3>{product.title}</h3>
          <p>{product.text}</p>
          <a class="btn btn-primary" href={product.href}>{product.cta}</a>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>

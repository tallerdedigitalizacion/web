---
import BaseLayout from "@/layouts/BaseLayout.astro";
import TrustBar from "@/components/TrustBar.astro";
import ContactForm from "@/components/ContactForm.astro";
import { siteConfig } from "@/config/site";
import { reviews } from "@/data/reviews";
import { planGroup, projectGroups, serviceCatalog } from "@/data/services";

const title = "Informático para empresas y digitalización en Toledo | Taller de Digitalización";
const description = "Soporte informático, ciberseguridad, webs y digitalización para PyMEs en Toledo, Torrijos, Illescas y a 50 km de Fuensalida. Presencial o en remoto. Primera llamada gratis.";

const steps: [string, string, string?][] = [
  ["Llamada gratuita de 15 minutos", "Me cuentas qué pasa. Si no veo cómo ayudarte, te lo digo.", siteConfig.bookingUrl],
  ["Propuesta cerrada", "Qué hay que hacer, en qué orden y cuánto cuesta. Sin letra pequeña."],
  ["Implementación", "En remoto o en tu empresa. Te explico lo que he hecho en lenguaje normal."],
  ["Plan mensual", `Revisiones, actualizaciones y soporte continuo desde ${siteConfig.planPriceFrom} €/mes + IVA, para que todo siga funcionando y no vuelvan los problemas.`],
];

const faqs: [string, string][] = [
  ["¿Dónde trabajas?", `Tengo base en Fuensalida (Toledo) y trabajo de forma presencial en un radio de ${siteConfig.serviceRadiusKm} km: Torrijos y su comarca, Toledo, La Sagra (Illescas, Yuncos, Seseña), Escalona y el Alberche, La Puebla de Montalbán y el sur y oeste de Madrid (Navalcarnero, Móstoles, Fuenlabrada, Alcorcón, Parla, Getafe). En remoto, con empresas de toda España.`],
  ["¿Atiendes a particulares o solo a empresas?", "Mi trabajo está pensado para empresas, autónomos y PyMEs: equipos, correo, web, herramientas y procesos del negocio."],
  ["¿Cuánto cuesta un informático para mi empresa?", `Hay dos formas de trabajar: planes mensuales desde ${siteConfig.planPriceFrom} €/mes + IVA (informática, web u operaciones e IA) o proyectos con presupuesto cerrado antes de empezar. La primera llamada es gratuita.`],
  ["¿Puedes resolver problemas en remoto?", "Sí. Con AnyDesk me conecto a tu equipo con tu permiso y la mayoría de incidencias de software, correo, cuentas y web se resuelven en el momento. Si hace falta tocar hardware o red, voy a tu empresa."],
  ["¿Me ayudas a cumplir la NIS2 y el RGPD?", "Sí. Reviso la situación de la empresa, priorizo las medidas técnicas y organizativas, y te acompaño en la documentación y la implantación. También si eres proveedor de una empresa que te exige cumplir NIS2."],
  ["¿Qué diferencia hay entre soporte informático y el diagnóstico de caos operativo?", "El soporte resuelve incidencias técnicas concretas. El diagnóstico mira cómo funciona la empresa entera: procesos, herramientas y dependencia del dueño, para decidir qué ordenar, automatizar o cambiar."],
];

const plans = serviceCatalog.filter((service) => service.group === planGroup);
const featuredReviews = reviews.slice(0, 3);
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath="/"
  faq={faqs}
  headerNavItems={[["Planes", "#servicios"], ["Proyectos", "#proyectos"], ["Zona", "#zona"], ["Cómo trabajo", "#como-trabajo"], ["FAQ", "#faq"], ["Contacto", "#contacto"]]}
>
  <section class="hero home-hero">
    <div class="hero-content">
      <span class="eyebrow">Informático y digitalización · Toledo</span>
      <h1>Informático para empresas y digitalización de PyMEs en Toledo.</h1>
      <p class="hero-subtitle">Soporte informático, ciberseguridad, webs y orden digital para empresas de Fuensalida, Torrijos, Toledo, La Sagra y el sur de Madrid. {siteConfig.experienceYears} años resolviendo problemas técnicos, presencial en {siteConfig.serviceRadiusKm} km o en remoto. Sin tecnicismos y sin venderte lo que no necesitas.</p>
      <div class="hero-actions">
        <a class="btn btn-primary" data-event="reservar_click" data-preserve-utm href={siteConfig.bookingUrl} target="_blank" rel="noreferrer">Reservar llamada gratuita</a>
        <a class="btn btn-secondary" href="#contacto">Escribirme</a>
      </div>
    </div>
  </section>

  <TrustBar />

  <section id="servicios" class="section">
    <div class="section-head">
      <span class="eyebrow">Servicios</span>
      <h2>Dos formas de trabajar conmigo.</h2>
      <p>Un plan mensual para que la informática, la web o la operación funcionen sin sustos, o un proyecto con precio cerrado para resolver algo concreto. Muchos proyectos terminan en un plan: lo que se monta hay que mantenerlo.</p>
    </div>
    <h3 class="service-group-title">Planes mensuales</h3>
    <div class="product-grid product-grid-3">
      {plans.map((plan) => (
        <article class="product-card">
          <span class="eyebrow">Plan mensual</span>
          <h3>{plan.label}</h3>
          <p>{plan.summary}</p>
          <p class="price-tag">Desde <strong>{siteConfig.planPriceFrom} €/mes</strong> + IVA</p>
          <a class="btn btn-primary" href={plan.href}>Ver plan</a>
        </article>
      ))}
    </div>
  </section>

  <section id="proyectos" class="section section-accent">
    <div class="section-head">
      <span class="eyebrow">Proyectos</span>
      <h2>Proyectos con precio cerrado.</h2>
      <p>Para resolver algo concreto, con principio y final, y un presupuesto cerrado antes de empezar. Si no sabes por dónde empezar, empieza por el <a href="/diagnostico-caos-operativo/">diagnóstico de caos operativo</a> o el <a href="/informe-gratuito-web/">informe gratuito de tu web</a>.</p>
    </div>
    {projectGroups.map((group) => (
      <div class="service-group">
        <h3 class="service-group-title">{group}</h3>
        <div class="link-grid">
          {serviceCatalog.filter((service) => service.group === group).map((service) => (
            <article>
              <strong>{service.label}</strong>
              <span>{service.summary}</span>
              <a class="btn btn-secondary btn-small" href={service.href}>Saber más</a>
            </article>
          ))}
        </div>
      </div>
    ))}
  </section>

  <section id="zona" class="section">
    <div class="section-head">
      <span class="eyebrow">Zona de trabajo</span>
      <h2>Informático en Fuensalida, Torrijos, Toledo y a {siteConfig.serviceRadiusKm} km a la redonda.</h2>
      <p>Trabajo de forma presencial en los municipios a menos de {siteConfig.serviceRadiusKm} km de Fuensalida y en remoto con cualquier empresa de España. Si tu empresa está en la zona, puedo ir a veros; si no, casi todo se puede resolver a distancia.</p>
      <p><strong>{siteConfig.name}</strong> · {siteConfig.address.streetAddress}, {siteConfig.address.postalCode} {siteConfig.address.addressLocality} ({siteConfig.address.addressRegion}) · {siteConfig.openingHours.map((h) => h.label).join(" · ")}</p>
    </div>
    <div class="region-grid">
      {siteConfig.serviceRegions.map((region) => (
        <article>
          <h3>{region.name}</h3>
          <p>{region.towns.join(", ")}.</p>
        </article>
      ))}
    </div>
    <div class="hero-actions">
      <a class="btn btn-secondary btn-small" href="/informatico-fuensalida-torrijos/">Fuensalida y Torrijos</a>
      <a class="btn btn-secondary btn-small" href="/informatico-empresas-toledo/">Toledo</a>
      <a class="btn btn-secondary btn-small" href="/informatico-illescas-la-sagra/">Illescas y La Sagra</a>
      <a class="btn btn-secondary btn-small" href="/informatico-navalcarnero-mostoles/">Navalcarnero y sur de Madrid</a>
    </div>
  </section>

  <section id="como-trabajo" class="section section-accent">
    <div class="section-head">
      <span class="eyebrow">Cómo trabajo</span>
      <h2>Cuatro pasos, sin vueltas.</h2>
      <p>{siteConfig.experienceYears} años desarrollando software y resolviendo problemas técnicos para empresas. Te atiende una persona real, no una agencia que te deriva.</p>
    </div>
    <div class="steps steps-4">
      {steps.map(([name, text, href], index) => (
        <article>
          <span class="step-number">{index + 1}</span>
          <h3>{href ? <a class="text-link" data-event="reservar_click" data-preserve-utm href={href} target="_blank" rel="noreferrer">{name}</a> : name}</h3>
          <p>{text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <span class="eyebrow">Reseñas</span>
      <h2>Lo que dicen los clientes.</h2>
      <p>Reseñas reales de <a href={siteConfig.googleBusinessUrl} target="_blank" rel="noreferrer">nuestra ficha de Google</a>.</p>
    </div>
    <div class="steps">
      {featuredReviews.map((review) => (
        <article>
          <strong>{review.name}</strong>
          <span class="microcopy">{review.source} · {review.rating}/5</span>
          <p>{review.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section id="faq" class="section">
    <div class="section-head"><span class="eyebrow">Preguntas frecuentes</span><h2>Dudas habituales antes de llamar.</h2></div>
    <div class="faq-list">{faqs.map(([q, a]) => <details><summary>{q}</summary><p>{a}</p></details>)}</div>
  </section>

  <ContactForm />
</BaseLayout>

---
import ServiceLanding from "@/components/ServiceLanding.astro";

const sections = [
  {
    id: "what-it-includes",
    eyebrow: "What it includes",
    heading: "Everything you need to bring order back.",
    variant: "tag" as const,
    items: [
      "Review of users and licenses",
      "Group organization",
      "Permissions review",
      "Security policies",
      "Organization of shared accounts",
      "Administration best practices",
    ],
  },
  {
    id: "ideal-for",
    eyebrow: "Ideal for businesses that…",
    heading: "Does any of this sound familiar?",
    variant: "check" as const,
    items: [
      "Have grown quickly",
      "Have changed staff several times",
      "Don't know who has access to what",
      "Want to improve security without complicating daily work",
    ],
  },
];
---

<ServiceLanding
  lang="en"
  title="Google Workspace Reorganization | Taller de Digitalización"
  description="We organize your Google Workspace so each person only has access to what they need, and your business gains security, order and efficiency."
  slug="/google-workspace-reorganization"
  schemaDescription="Google Workspace reorganization: users, licenses, groups, permissions and security policies for businesses."
  schemaAreaServed={["United States", "Remote"]}
  eyebrow="Google Workspace Reorganization"
  h1="An organized business moves faster."
  subtitleParagraphs={[
    "Over time, Google Workspace tends to fill up with unused users, incorrect permissions, duplicate groups and settings nobody remembers the reason for.",
    "We organize your environment so each person only has access to what they need, and your business gains security, order and efficiency.",
  ]}
  sections={sections}
  finalCtaHeading="Take back control of your Google Workspace."
/>

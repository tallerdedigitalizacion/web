---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getPublishedPosts } from "@/utils/blog";

const posts = await getPublishedPosts();
const dateFormat = new Intl.DateTimeFormat("es-ES", { dateStyle: "long" });
---

<BaseLayout
  title="Blog de informática y digitalización para PyMEs | Taller de Digitalización"
  description="Guías prácticas sobre informática, ciberseguridad, NIS2, webs y digitalización para PyMEs de Toledo y el sur de Madrid."
  canonicalPath="/blog"
>
  <section class="section">
    <div class="section-head">
      <span class="eyebrow">Blog</span>
      <h1>Informática y digitalización para PyMEs, sin jerga.</h1>
      <p>Respuestas a las preguntas que me hacen las empresas de Toledo, Torrijos, La Sagra y el sur de Madrid.</p>
    </div>
    <div class="link-grid">
      {posts.map((post) => (
        <article>
          <strong>{post.data.title}</strong>
          <span>{dateFormat.format(post.data.pubDate)} · {post.data.description}</span>
          <a class="btn btn-secondary btn-small" href={`/blog/${post.slug}/`}>Leer artículo</a>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>

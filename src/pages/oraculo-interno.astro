---
import ServiceLanding from "@/components/ServiceLanding.astro";

const sections = [
  {
    id: "que-puede-hacer",
    eyebrow: "¿Qué puede hacer?",
    heading: "Una respuesta clara para cada consulta interna.",
    variant: "tag" as const,
    items: [
      "Consultar procedimientos",
      "Buscar documentación",
      "Resolver dudas internas",
      "Facilitar la incorporación de nuevos empleados",
      "Reducir interrupciones entre equipos",
    ],
  },
  {
    id: "beneficios",
    eyebrow: "Beneficios",
    heading: "Lo que gana su equipo.",
    variant: "check" as const,
    items: [
      "Menos tiempo buscando información",
      "Respuestas consistentes",
      "Mayor productividad",
      "Conservación del conocimiento de la empresa",
    ],
  },
];
---

<ServiceLanding
  title="Asistente de IA con los documentos de tu empresa | Taller de Digitalización"
  description="El asistente de IA interno usa inteligencia artificial para responder preguntas de su equipo basándose únicamente en la información de su empresa."
  slug="/oraculo-interno"
  schemaDescription="Asistente de IA con los documentos de tu empresa: asistente de inteligencia artificial que responde preguntas internas usando la documentación de la empresa."
  eyebrow="Asistente de IA con los documentos de tu empresa"
  h1="El conocimiento de su empresa disponible en segundos."
  subtitleParagraphs={[
    "Procedimientos, manuales, documentación y preguntas frecuentes suelen estar repartidos entre carpetas, correos y documentos.",
    "El asistente de IA interno utiliza inteligencia artificial para responder preguntas basándose únicamente en la información de su empresa.",
  ]}
  sections={sections}
  finalCtaHeading="La información correcta, en el momento adecuado."
/>

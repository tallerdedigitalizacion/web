---
import ServiceLanding from "@/components/ServiceLanding.astro";

const sections = [
  {
    id: "what-it-can-do",
    eyebrow: "What it can do",
    heading: "Smart support, available around the clock.",
    variant: "tag" as const,
    items: [
      "Answer frequently asked questions",
      "Recommend products or services",
      "Capture new customers",
      "Generate contact requests",
      "Reduce the load on your support team",
    ],
  },
  {
    id: "benefits",
    eyebrow: "Benefits",
    heading: "More coverage, less load on your team.",
    variant: "check" as const,
    items: [
      "24/7 support",
      "Fewer repetitive inquiries",
      "More sales opportunities",
      "Better customer experience",
    ],
  },
];
---

<ServiceLanding
  lang="en"
  title="AI chatbot for small business: website and WhatsApp, from $1,100 | Taller de Digitalización"
  description="An AI chatbot (AI agent) that answers customer questions on your website or WhatsApp using your company's information, and hands off to your team when needed."
  slug="/ai-chatbot-small-business"
  schemaDescription="AI chatbot for small business: an AI assistant that supports customers, answers FAQs and captures leads."
  schemaAreaServed={["United States", "Remote"]}
  eyebrow="AI chatbot for small business"
  h1="Support your customers even outside business hours."
  subtitleParagraphs={[
    "Customers expect fast answers. Many inquiries are repetitive and eat up your team's time.",
    "The AI chatbot answers automatically using your company's information and hands off to your sales team when needed.",
  ]}
  sections={sections}
  finalCtaHeading="Turn your website into a smart support channel."
/>

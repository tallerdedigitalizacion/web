---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ReviewsCarousel from "@/components/ReviewsCarousel.astro";
import LeadMagnetQuiz from "@/components/LeadMagnetQuiz.astro";
import CaseStory from "@/components/CaseStory.astro";
import PageVideo from "@/components/PageVideo.astro";
import OfferBox from "@/components/OfferBox.astro";
import { siteConfig } from "@/config/site";
import { withBase } from "@/utils/paths";

const title = "Optimización de velocidad web: ¿tu web va lenta? Desde 250 € y análisis gratuito | Taller de Digitalización";
const description = "¿Tu web va lenta? Haz el análisis gratuito de velocidad, SEO y seguridad y, si hace falta, la acelero sin rehacerla: desde 250 € + IVA, en 3 a 5 días y con las cifras de antes y después.";
const googleReviewsUrl = "https://maps.app.goo.gl/iJYaupqoL8usLB6X7";

const costBullets = ["Se van antes de cargar", "Google te penaliza", "Menos contactos y ventas"];
const steps = [
  "Haces el análisis gratuito de tu web o reservas una llamada de 15 min",
  "Te digo qué la frena y cuánto cuesta arreglarlo",
  "La acelero y lo verificamos con PageSpeed y Core Web Vitals",
];
const faqs = [
  ["¿Hace falta rehacer la web?", "No, optimizo lo que ya tienes."],
  ["¿En qué plataformas trabajas?", "WordPress y la mayoría de stacks."],
  ["¿Cuánto tarda?", "De 3 a 5 días laborables una vez aprobado el presupuesto."],
  ["¿Cuánto cuesta?", "El análisis y el diagnóstico son gratis. Acelerar la web cuesta desde 250 € + IVA; el precio cerrado te lo doy tras ver tu web, antes de empezar."],
  ["¿Qué es el análisis gratuito de mi web?", "Un cuestionario de unos minutos que revisa velocidad, SEO básico, seguridad y captación de contactos, y te devuelve una puntuación con lo que conviene arreglar primero."],
];

const navItems = [
  ["Coste", "#coste"],
  ["Análisis gratis", "#analisis"],
  ["Precio", "#precio"],
  ["Qué hago", "#que-hago"],
  ["Cómo funciona", "#como-funciona"],
  ["Autoevaluación", "#autoevaluacion"],
  ["Por qué yo", "#por-que-yo"],
  ["FAQ", "#faq"],
];

---

<BaseLayout
  title={title}
  description={description}
  canonicalPath="/optimizacion-velocidad-web"
  headerNavItems={navItems}
  alternates={[["es-ES", "/optimizacion-velocidad-web"], ["en", "/website-speed-optimization"], ["x-default", "/optimizacion-velocidad-web"]]}
  faq={faqs}
  headerBookingEvent="reservar_click"
>
  <section class="hero">
    <div class="hero-content">
      <span class="eyebrow">Optimización de velocidad web · Core Web Vitals</span>
      <h1>Mi web va lenta: la acelero sin rehacerla y te enseño las cifras.</h1>
      <p class="hero-subtitle">Si tu web tarda en cargar, pierdes visitas antes de que vean nada. Haz el análisis gratuito para ver cómo está, y si hace falta la acelero: trabajo técnico, sin rehacerla entera y sin venderte marketing.</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href={withBase("/informe-gratuito-web/")}>Análisis gratuito de mi web</a>
        <a class="btn btn-secondary" data-event="reservar_click" data-preserve-utm href={siteConfig.bookingUrl} target="_blank" rel="noreferrer">Reservar llamada gratuita</a>
      </div>
    </div>
  </section>

  <OfferBox path="/optimizacion-velocidad-web/" />

  <section id="analisis" class="section section-accent">
    <div class="section-head">
      <span class="eyebrow">Análisis gratuito de tu web</span>
      <h2>Antes de pagar nada, mira cómo está tu web.</h2>
      <p>En pocos minutos revisas la velocidad, el SEO básico, la seguridad y si tu web recoge contactos. Te devuelve una puntuación y lo que conviene arreglar primero. Es gratis y no te compromete a nada.</p>
    </div>
    <div class="hero-actions">
      <a class="btn btn-primary" href={withBase("/informe-gratuito-web/")}>Hacer el análisis gratuito</a>
    </div>
  </section>

  <section id="coste" class="section">
    <div class="section-head">
      <span class="eyebrow">El coste de una web lenta</span>
      <h2>La espera también factura.</h2>
      <p>Una web lenta pierde visitantes antes de que vean nada, baja tu posición en Google (Core Web Vitals) y reduce las conversiones. No es estético: es dinero que se va.</p>
    </div>
    <div class="tag-grid">
      {costBullets.map((item) => <span>{item}</span>)}
    </div>
  </section>

  <section id="que-hago" class="section section-split">
    <div>
      <span class="eyebrow">Qué hago</span>
      <h2>Diagnóstico técnico, arreglo medible.</h2>
      <p>Reservas una llamada de diagnóstico gratis. Te digo en concreto qué frena tu web (imágenes, caché, render, hosting, código) y qué se puede arreglar. Si encaja, te paso presupuesto y lo arreglo. Lo verificamos con métricas antes/después.</p>
    </div>
    <div class="honest-note">
      <span class="eyebrow">Frontera de nicho</span>
      <p>No vendo SEO de contenidos ni campañas. Soluciono el problema técnico.</p>
    </div>
  </section>

  <section id="como-funciona" class="section section-accent">
    <div class="section-head">
      <span class="eyebrow">Cómo funciona</span>
      <h2>3 pasos, sin vueltas.</h2>
    </div>
    <div class="steps">
      {steps.map((step, index) => (
        <article>
          <span class="step-number">{index + 1}</span>
          <h3>{step}</h3>
        </article>
      ))}
    </div>
  </section>

  <PageVideo path={"/optimizacion-velocidad-web/"} />
  <CaseStory path={"/optimizacion-velocidad-web/"} />

  <LeadMagnetQuiz id="speed" lang="es" />

  <section id="por-que-yo" class="section">
    <div class="section-head">
      <span class="eyebrow">Por qué yo</span>
      <h2>Una persona técnica mirando el problema de frente.</h2>
      <p>Más de 15 años desarrollando y optimizando software. <a class="google-review-link" href={googleReviewsUrl} target="_blank" rel="noreferrer">
        <svg class="google-mark" aria-hidden="true" viewBox="0 0 24 24" width="18" height="18">
          <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.76h3.56c2.08-1.92 3.28-4.74 3.28-8.09Z"/>
          <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.56-2.76c-.98.66-2.24 1.06-3.72 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84A11 11 0 0 0 12 23Z"/>
          <path fill="#FBBC05" d="M5.84 14.11a6.61 6.61 0 0 1 0-4.22V7.05H2.18a11 11 0 0 0 0 9.9l3.66-2.84Z"/>
          <path fill="#EA4335" d="M12 5.36c1.62 0 3.06.56 4.21 1.64l3.15-3.15A10.56 10.56 0 0 0 12 1 11 11 0 0 0 2.18 7.05l3.66 2.84C6.71 7.29 9.14 5.36 12 5.36Z"/>
        </svg>
        +10 reseñas en Google
      </a> y +1.000 seguidores en LinkedIn. Una persona real que te atiende, no una agencia que te deriva a un becario.</p>
    </div>
    <ReviewsCarousel lang="es" />
  </section>

  <section id="faq" class="section">
    <div class="section-head">
      <span class="eyebrow">Preguntas frecuentes</span>
      <h2>Dudas habituales antes del diagnóstico.</h2>
    </div>
    <div class="faq-list">
      {faqs.map(([question, answer]) => (
        <details>
          <summary>{question}</summary>
          <p>{answer}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="section final-cta">
    <h2>Haz el análisis gratuito o reserva una llamada y veamos qué está frenando tu web.</h2>
    <div class="hero-actions">
      <a class="btn btn-primary" href={withBase("/informe-gratuito-web/")}>Análisis gratuito de mi web</a>
      <a class="btn btn-secondary" data-event="reservar_click" data-preserve-utm href={siteConfig.bookingUrl} target="_blank" rel="noreferrer">Reservar llamada gratuita</a>
    </div>
  </section>
</BaseLayout>

<script>
  import { BOOKING_URLS } from "@/config/booking";

  const params = new URLSearchParams(window.location.search);
  const utmEntries = [...params.entries()].filter(([key]) => key.toLowerCase().startsWith("utm_"));

  if (utmEntries.length > 0) {
    document.querySelectorAll(`[data-preserve-utm], ${BOOKING_URLS.map((url) => `a[href^="${url}"]`).join(", ")}`).forEach((link) => {
      if (!(link instanceof HTMLAnchorElement)) return;
      const url = new URL(link.href);
      utmEntries.forEach(([key, value]) => {
        if (!url.searchParams.has(key)) url.searchParams.set(key, value);
      });
      link.href = url.toString();
    });
  }

  document.querySelectorAll(".faq-list details").forEach((item) => {
    item.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      if (target.closest("summary")) return;
      item.open = !item.open;
    });
  });
</script>

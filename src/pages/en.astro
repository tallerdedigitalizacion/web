---
import BaseLayout from "@/layouts/BaseLayout.astro";
import TrustBar from "@/components/TrustBar.astro";
import ContactForm from "@/components/ContactForm.astro";
import { siteConfig } from "@/config/site";
import ReviewsCarousel from "@/components/ReviewsCarousel.astro";
import { projectGroupsEn, serviceCatalogEn } from "@/data/servicesEn";
import { offerFor, priceLabel } from "@/data/offers";
import { billarArrabal } from "@/data/portfolio";
import { withBase } from "@/utils/paths";
import { existsSync } from "node:fs";

const title = "AI automation and systems integration for small businesses, fully remote | Taller de Digitalización";
const description = "A senior software developer automates the repetitive work in your business: invoices, data copied between tools, CRM, chatbots and custom tools. Fixed prices in USD, fully remote. First call is free.";

const steps: [string, string, string?][] = [
  ["Free 15-minute call", "You tell me what's going on. If I don't see how I can help, I'll say so.", siteConfig.bookingUrlEn],
  ["Fixed-price proposal", "What needs doing, in what order and how much it costs. No small print."],
  ["Build and handover", "Done remotely, with progress updates waiting in your inbox each morning. You own everything I build."],
  ["Keep it running", "Optional ongoing support so the automations keep working as your tools change. Ask for a quote."],
];

const faqs: [string, string][] = [
  ["Where do you work, and what hours?", "Everything is delivered remotely, so I work with businesses and agencies wherever they are. I am available for calls from 9:00 to 13:00 Eastern Time (6:00 to 10:00 Pacific). Updates and documentation are in English and are written so you can read them asynchronously."],
  ["How much does it cost?", "Every project has a fixed quote before we start, in US dollars and excluding taxes. An operations audit starts at $750 and an Automation Sprint (one process automated end to end) starts at $3,000. The first call is free."],
  ["How do you get paid?", "50% when we start and 50% on delivery, by bank transfer, Wise or card, in US dollars."],
  ["Who owns the code and the accounts?", "You do. Code, automations and accounts are in your name, and everything is documented. Ownership passes to you when the final payment is made."],
  ["What happens if something breaks after delivery?", "Integration and custom-tool projects include 30 days of adjustments after delivery. After that you can book ongoing support or ask for a one-off fix, so nothing depends on guessing who built it."],
  ["Do you work with agencies?", "Yes. If a client asks for something technical that your team does not build (an integration, an automation, a custom tool), I can build it under your brand at a fixed price."],
  ["Do you help individuals or only businesses?", "My work is designed for businesses, freelancers and small companies: tools, data and business processes."],
];

const scoreboard = billarArrabal.images.scoreboard;
// La foto se muestra solo si el archivo existe en public/.
const founderPhoto = ["jpg", "jpeg", "png", "webp"].map((ext) => `/pablo-leone.${ext}`).find((src) => existsSync(`public${src}`));
const startHere = [
  { label: "Operations audit", href: "/digitalization-assessment/", text: "A review of your processes and tools, with a prioritized report of what to change and in which order." },
  { label: "Automation Sprint", href: "/ai-process-automation/", text: "One repetitive process automated end to end, for a fixed price, with a person confirming what matters." },
].map((item) => {
  const offer = offerFor(item.href, "en");
  return { ...item, price: offer ? priceLabel(offer, "en") : "", deadline: offer?.deadline };
});
---

<BaseLayout

  title={title}
  description={description}
  canonicalPath="/en"
  lang="en"
  faq={faqs}
  showChatbase={false}
  headerNavItems={[["Start here", "#start"], ["Solutions", "#projects"], ["Portfolio", "#portfolio"], ["How I work", "#how-i-work"], ["FAQ", "#faq"], ["Contact", "#contacto"]]}
>
  <section class="hero home-hero">
    <div class="hero-content">
      <span class="eyebrow">Automation &amp; AI · Remote</span>
      <h1>Your team re-types the same data into three tools. I automate it for a fixed price.</h1>
      <p class="hero-founder">{founderPhoto && <img src={withBase(founderPhoto)} alt="Pablo Leone, software developer" width="64" height="64" loading="eager" />}<span>I'm <strong>Pablo Leone</strong>, a software developer based in Spain.</span></p>
      <p class="hero-subtitle">A senior software developer with {siteConfig.experienceYears} years building and fixing business software. I automate invoices, data entry, follow-up and reporting for small businesses and agencies, fully remote. Fixed prices in USD, you own everything I build.</p>
      <div class="hero-actions">
        <a class="btn btn-primary" data-event="reservar_click" data-preserve-utm href={siteConfig.bookingUrlEn} target="_blank" rel="noreferrer">Book a free call</a>
        <a class="btn btn-secondary" href="#contacto">Write to me</a>
      </div>
    </div>
  </section>

  <TrustBar lang="en" />

  <section id="start" class="section">
    <div class="section-head">
      <span class="eyebrow">Start here</span>
      <h2>Two ways to start.</h2>
      <p>A short audit to find what is worth fixing, or one process automated end to end. Both with a fixed quote before we start.</p>
    </div>
    <div class="product-grid">
      {startHere.map((item) => (
        <article class="product-card">
          <span class="eyebrow">{item.deadline}</span>
          <h3>{item.label}</h3>
          <p>{item.text}</p>
          <p class="price-tag"><strong>{item.price}</strong></p>
          <a class="btn btn-primary" href={item.href}>Learn more</a>
        </article>
      ))}
    </div>
  </section>

  <section id="projects" class="section section-accent">
    <div class="section-head">
      <span class="eyebrow">What you need to solve</span>
      <h2>Every solution, with its price and timing.</h2>
      <p>Pick what you want to solve and see what it costs and how long it takes. Prices are in US dollars, excluding taxes, and are "from": the fixed price comes after a first review, before we start. If you don't know where to start, get the <a href="/free-website-report/">free report on your website</a> or the <a href="/digitalization-assessment/">process audit</a>.</p>
    </div>
    {projectGroupsEn.map((group) => (
      <div class="service-group">
        <h3 class="service-group-title">{group}</h3>
        <div class="link-grid">
          {serviceCatalogEn.filter((service) => service.group === group).map((service) => (
            <article>
              <strong>{service.label}</strong>
              <span>{service.summary}</span>
              {service.price && <span class="service-offer"><b>{service.price}</b>{service.deadline && <> · {service.deadline}</>}</span>}
              <a class="btn btn-secondary btn-small" href={service.href}>Learn more</a>
            </article>
          ))}
        </div>
      </div>
    ))}
  </section>

  <section id="portfolio" class="section">
    <div class="section-head">
      <span class="eyebrow">Portfolio</span>
      <h2>A rescued app for a pool club.</h2>
      <p>A club's scoring app had been left half-finished. I picked it up with AI, simplified it, and today any club can use it.</p>
    </div>
    <div class="portfolio-teaser">
      <img src={withBase(scoreboard.src)} alt="The app's scoreboard during a match: points, average, inning, time and a turn timer bar for each player" width={scoreboard.width} height={scoreboard.height} loading="lazy" />
      <div>
        <h3>Billar El Arrabal scoreboard</h3>
        <p class="muted">A carom billiards scoreboard that records the match on video with the score on screen.</p>
        <a class="btn btn-secondary" href={billarArrabal.appUrl} target="_blank" rel="noreferrer">Try the app</a>
      </div>
    </div>
  </section>

  <section id="how-i-work" class="section section-accent">
    <div class="section-head">
      <span class="eyebrow">How I work</span>
      <h2>Four steps, no detours.</h2>
      <p>{siteConfig.experienceYears} years developing software and solving technical problems for businesses. You deal with a real person, not an agency that hands you off.</p>
    </div>
    <div class="steps steps-4">
      {steps.map(([name, text, href], index) => (
        <article>
          <span class="step-number">{index + 1}</span>
          <h3>{href ? <a class="text-link" data-event="reservar_click" data-preserve-utm href={href} target="_blank" rel="noreferrer">{name}</a> : name}</h3>
          <p>{text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <span class="eyebrow">Reviews</span>
      <h2>What clients say.</h2>
      <p>Real reviews from <a href={siteConfig.googleBusinessUrl} target="_blank" rel="noreferrer">our Google profile</a>, translated from Spanish.</p>
    </div>
    <ReviewsCarousel lang="en" />
  </section>

  <section id="faq" class="section">
    <div class="section-head"><span class="eyebrow">FAQ</span><h2>Common questions before calling.</h2></div>
    <div class="faq-list">{faqs.map(([q, a]) => <details><summary>{q}</summary><p>{a}</p></details>)}</div>
  </section>

  <ContactForm lang="en" />
</BaseLayout>

<style>
  .hero-founder {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0 0 12px;
    font-size: 1.05rem;
  }

  .hero-founder img {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--line);
  }

  .portfolio-teaser {
    display: grid;
    grid-template-columns: minmax(0, 420px) 1fr;
    gap: clamp(20px, 4vw, 40px);
    align-items: center;
    max-width: 920px;
  }

  .portfolio-teaser img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }

  .portfolio-teaser h3 {
    font-size: clamp(1.4rem, 2.4vw, 1.9rem);
  }

  @media (max-width: 720px) {
    .portfolio-teaser {
      grid-template-columns: 1fr;
    }
  }
</style>

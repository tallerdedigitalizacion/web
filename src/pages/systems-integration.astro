---
import ServiceLanding from "@/components/ServiceLanding.astro";

const sections = [
  {
    id: "what-it-includes",
    eyebrow: "What it includes",
    heading: "From idea to a working integration.",
    variant: "tag" as const,
    items: [
      "Feasibility study",
      "Integration design",
      "Data exchange automation",
      "Testing",
      "Go-live",
    ],
  },
  {
    id: "ideal-for",
    eyebrow: "Ideal for businesses that…",
    heading: "Does any of this sound familiar?",
    variant: "check" as const,
    items: [
      "Enter the same data multiple times",
      "Work with several platforms",
      "Want to automate processes without switching software",
    ],
  },
];
---

<ServiceLanding
  lang="en"
  title="Systems Integration | Taller de Digitalización"
  description="We look at how to connect your systems (CRM, ERP, invoicing, email) to eliminate manual tasks and reduce errors."
  slug="/systems-integration"
  schemaDescription="Systems integration: feasibility study, integration design, data exchange automation and go-live."
  schemaAreaServed={["United States", "Remote"]}
  eyebrow="Systems Integration"
  h1="Make your tools work together."
  subtitleParagraphs={[
    "CRM, ERP, invoicing, email and other applications usually work in isolation.",
    "We look at how to connect your systems to eliminate manual tasks and reduce errors.",
  ]}
  sections={sections}
  finalCtaHeading="If your tools already work, let's make them work together."
/>

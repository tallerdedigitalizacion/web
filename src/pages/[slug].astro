---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { siteConfig } from "@/config/site";
import TrustBar from "@/components/TrustBar.astro";
import CaseStory from "@/components/CaseStory.astro";
import ContactForm from "@/components/ContactForm.astro";
import { localPages, type LocalPage } from "@/data/localPages";
import { productPages } from "@/data/productPages";
import { plansEn } from "@/data/plansEn";
import { serviceLabelFor } from "@/data/services";

export function getStaticPaths() {
  return [...localPages, ...productPages, ...plansEn].map((page) => ({ params: { slug: page.slug }, props: { page } }));
}

const { page } = Astro.props as { page: LocalPage };
const lang = page.lang ?? "es";
const isEnglish = lang === "en";
const t = isEnglish
  ? {
      home: "Home",
      book: "Book a free call",
      write: "Write to me",
      planPrice: "Monthly plan from",
      vat: "+ VAT",
      perMonth: "/month",
      recognise: "Sound familiar?",
      approach: "The approach",
      services: "Services",
      zone: "Delivery",
      process: "Process",
      faqEyebrow: "FAQ",
      faqTitle: "Common questions",
      relatedEyebrow: "You might also like",
      relatedTitle: "Other services",
      nav: [["What's included", "#servicios"], ["Delivery", "#zona"], ["FAQ", "#faq"], ["Contact", "#contacto"]],
    }
  : {
      home: "Inicio",
      book: "Reservar llamada gratuita",
      write: "Escribirme",
      planPrice: "Plan mensual desde",
      vat: "+ IVA",
      perMonth: "€/mes",
      recognise: "¿Te suena?",
      approach: "El enfoque",
      services: "Servicios",
      zone: "Zona",
      process: "Proceso",
      faqEyebrow: "Preguntas frecuentes",
      faqTitle: "Dudas habituales",
      relatedEyebrow: "También te puede interesar",
      relatedTitle: "Otros servicios",
      nav: [["Servicios", "#servicios"], ["Zona", "#zona"], ["FAQ", "#faq"], ["Contacto", "#contacto"]],
    };
const path = `/${page.slug}/`;
const pageUrl = new URL(path, siteConfig.publicUrl).toString();
const businessId = `${siteConfig.publicUrl}/#business`;
const formService = page.formService ?? serviceLabelFor(path) ?? "";
const priceText = page.priceFrom ? (isEnglish ? `€${page.priceFrom}${t.perMonth}` : `${page.priceFrom} ${t.perMonth}`) : "";

const extraSchema = [
  {
    "@type": "Service",
    "@id": `${pageUrl}#service`,
    name: page.h1.replace(/\.$/, ""),
    serviceType: page.schemaService,
    description: page.description,
    url: pageUrl,
    provider: { "@id": businessId },
    areaServed: page.areas.map((name) => ({ "@type": "Place", name })),
    ...(page.priceFrom && {
      offers: {
        "@type": "Offer",
        url: pageUrl,
        price: page.priceFrom,
        priceCurrency: "EUR",
        priceSpecification: {
          "@type": "UnitPriceSpecification",
          price: page.priceFrom,
          priceCurrency: "EUR",
          unitCode: "MON",
          referenceQuantity: { "@type": "QuantitativeValue", value: 1, unitCode: "MON" },
          valueAddedTaxIncluded: false,
        },
      },
    }),
  },
  {
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: t.home, item: `${siteConfig.publicUrl}/` },
      { "@type": "ListItem", position: 2, name: page.h1.replace(/\.$/, ""), item: pageUrl },
    ],
  },
];

const navItems = t.nav;
---

<BaseLayout title={page.title} description={page.description} canonicalPath={path} faq={page.faq} extraSchema={extraSchema} headerNavItems={navItems} lang={lang} showChatbase={!isEnglish}>
  <section class="hero">
    <div class="hero-content">
      <span class="eyebrow">{page.eyebrow}</span>
      <h1>{page.h1}</h1>
      <p class="hero-subtitle">{page.intro}</p>
      {page.priceFrom && <p class="price-tag">{t.planPrice} <strong>{priceText}</strong> {t.vat}</p>}
      <div class="hero-actions">
        <a class="btn btn-primary" data-event="reservar_click" data-preserve-utm href={siteConfig.bookingUrl} target="_blank" rel="noreferrer">{t.book}</a>
        <a class="btn btn-secondary" href="#contacto">{t.write}</a>
      </div>
    </div>
  </section>

  <TrustBar lang={lang} />

  <section class="section section-split">
    <div>
      <span class="eyebrow">{t.recognise}</span>
      <h2>{page.problemsTitle}</h2>
    </div>
    <ul class="check-list">{page.problems.map((problem) => <li>{problem}</li>)}</ul>
  </section>

  {page.insight && (
    <section class="section">
      <div class="section-head">
        <span class="eyebrow">{t.approach}</span>
        <h2>{page.insightTitle}</h2>
        {page.insight.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </section>
  )}

  <section id="servicios" class="section section-accent">
    <div class="section-head">
      <span class="eyebrow">{t.services}</span>
      <h2>{page.servicesTitle}</h2>
    </div>
    <div class="steps">
      {page.services.map(([name, text]) => (
        <article>
          <h3>{name}</h3>
          <p>{text}</p>
        </article>
      ))}
    </div>
  </section>

  {!isEnglish && <CaseStory path={path} />}

  <section id="zona" class={isEnglish ? "section" : "section section-split"}>
    <div class={isEnglish ? "section-head" : undefined}>
      <span class="eyebrow">{t.zone}</span>
      <h2>{page.zoneTitle}</h2>
      {page.zoneText.map((text) => <p>{text}</p>)}
    </div>
    {!isEnglish && <div class="tag-grid area-grid">{page.areas.map((area) => <span>{area}</span>)}</div>}
  </section>

  <section class="section">
    <div class="section-head">
      <span class="eyebrow">{t.process}</span>
      <h2>{page.approachTitle}</h2>
    </div>
    <div class={page.approach.length === 4 ? "steps steps-4" : "steps"}>
      {page.approach.map(([name, text], index) => (
        <article>
          <span class="step-number">{index + 1}</span>
          <h3>{name}</h3>
          <p>{text}</p>
        </article>
      ))}
    </div>
  </section>

  {page.testimonial && (
    <section class="section">
      <blockquote class="testimonial">
        <p>“{page.testimonial.text}”</p>
        <footer><strong>{page.testimonial.author}</strong> · <a href={siteConfig.googleBusinessUrl} target="_blank" rel="noreferrer">{page.testimonial.source}</a></footer>
      </blockquote>
    </section>
  )}

  <section id="faq" class="section">
    <div class="section-head"><span class="eyebrow">{t.faqEyebrow}</span><h2>{t.faqTitle}</h2></div>
    <div class="faq-list">{page.faq.map(([q, a]) => <details><summary>{q}</summary><p>{a}</p></details>)}</div>
  </section>

  <section class="section">
    <div class="section-head"><span class="eyebrow">{t.relatedEyebrow}</span><h2>{t.relatedTitle}</h2></div>
    <div class="tag-grid">
      {page.related.map(([label, href]) => <a class="btn btn-secondary" href={href}>{label}</a>)}
    </div>
  </section>

  <ContactForm lang={lang} selectedService={formService} title={page.finalCta} />
</BaseLayout>

---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { siteConfig } from "@/config/site";
import TrustBar from "@/components/TrustBar.astro";
import ContactForm from "@/components/ContactForm.astro";
import VideoEmbed from "@/components/VideoEmbed.astro";
import { casePages, entryOffer, formatEuro, type CasePage } from "@/data/casePages";

export function getStaticPaths() {
  return casePages.map((page) => ({ params: { slug: page.slug }, props: { page } }));
}

const { page } = Astro.props as { page: CasePage };
const path = `/casos/${page.slug}/`;
const pageUrl = new URL(path, siteConfig.publicUrl).toString();
const businessId = `${siteConfig.publicUrl}/#business`;
const entry = entryOffer(page);
const others = casePages.filter((item) => item.slug !== page.slug);

const extraSchema = [
  {
    "@type": "Service",
    "@id": `${pageUrl}#service`,
    name: page.h1.replace(/\.$/, ""),
    serviceType: page.schemaService,
    description: page.description,
    url: pageUrl,
    provider: { "@id": businessId },
    areaServed: { "@type": "Country", name: "España" },
    offers: page.offers.map((offer) => ({
      "@type": "Offer",
      name: offer.name,
      url: pageUrl,
      price: offer.price,
      priceCurrency: "EUR",
      priceSpecification: { "@type": "PriceSpecification", price: offer.price, priceCurrency: "EUR", valueAddedTaxIncluded: false },
    })),
  },
  {
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Inicio", item: `${siteConfig.publicUrl}/` },
      { "@type": "ListItem", position: 2, name: "Casos prácticos", item: `${siteConfig.publicUrl}/casos/` },
      { "@type": "ListItem", position: 3, name: page.h1.replace(/\.$/, ""), item: pageUrl },
    ],
  },
];

const navItems = [
  ["El caso", "#caso"],
  ["Precio", "#precio"],
  ["FAQ", "#faq"],
  ["Contacto", "#contacto"],
];
---

<BaseLayout title={page.title} description={page.description} canonicalPath={path} faq={page.faq} extraSchema={extraSchema} headerNavItems={navItems}>
  <section class="hero">
    <div class="hero-content">
      <span class="eyebrow">{page.eyebrow}</span>
      <h1>{page.h1}</h1>
      <p class="hero-subtitle">{page.intro}</p>
      <p class="price-tag">{page.offers.length > 1 || !entry.fixed ? "Desde" : "Precio cerrado:"} <strong>{formatEuro(entry.price)}</strong> + IVA</p>
      <div class="hero-actions">
        <a class="btn btn-primary" data-event="reservar_click" data-preserve-utm href={siteConfig.bookingUrl} target="_blank" rel="noreferrer">Reservar llamada gratuita</a>
        <a class="btn btn-secondary" href="#contacto">Escribirme</a>
      </div>
    </div>
  </section>

  <TrustBar />

  <section id="caso" class="section">
    <div class="section-head">
      <span class="eyebrow">Caso práctico</span>
      <h2>El caso, en palabras simples.</h2>
      {page.practical.map((paragraph) => <p>{paragraph}</p>)}
    </div>
    <VideoEmbed videoId={page.videoId} title={`Vídeo: ${page.h1}`} />
  </section>

  <section class="section section-split">
    <div>
      <span class="eyebrow">¿Te suena?</span>
      <h2>{page.painTitle}</h2>
    </div>
    <ul class="check-list">{page.pains.map((pain) => <li>{pain}</li>)}</ul>
  </section>

  <section id="que-montamos" class="section section-accent">
    <div class="section-head">
      <span class="eyebrow">El caso</span>
      <h2>{page.builtTitle}</h2>
    </div>
    <div class="steps">
      {page.built.map(([name, text], index) => (
        <article>
          <span class="step-number">{index + 1}</span>
          <h3>{name}</h3>
          <p>{text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <span class="eyebrow">Resultado</span>
      <h2>{page.resultTitle}</h2>
      {page.result.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </section>

  <section id="precio" class="section section-accent">
    <div class="section-head">
      <span class="eyebrow">Precio</span>
      <h2>{page.offersTitle}</h2>
      <p>Precios sin IVA. Antes de empezar recibes una propuesta cerrada: lo que se hace, lo que cuesta y lo que no está incluido.</p>
    </div>
    <div class="product-grid case-offers">
      {page.offers.map((offer) => (
        <article class="product-card">
          <span class="eyebrow">{offer.fixed ? "Precio cerrado" : "Proyecto"}</span>
          <h3>{offer.name}</h3>
          <p>{offer.text}</p>
          <p class="price-tag">{offer.fixed ? "" : "Desde "}<strong>{formatEuro(offer.price)}</strong> + IVA</p>
        </article>
      ))}
      <article class="product-card">
        <span class="eyebrow">Plan mensual</span>
        <h3>Que siga funcionando</h3>
        <p>{page.planText}</p>
        <p class="price-tag">Desde <strong>{formatEuro(page.planPrice)}/mes</strong> + IVA</p>
      </article>
    </div>
  </section>

  {page.timeline && (
    <section class="section">
      <div class="section-head">
        <span class="eyebrow">Plazos</span>
        <h2>{page.timelineTitle}</h2>
      </div>
      <div class="steps steps-4">
        {page.timeline.map(([name, text], index) => (
          <article>
            <span class="step-number">{index + 1}</span>
            <h3>{name}</h3>
            <p>{text}</p>
          </article>
        ))}
      </div>
    </section>
  )}

  <section class="section section-split">
    <div>
      <span class="eyebrow">Cómo lo haríamos</span>
      <h2>{page.needsTitle}</h2>
      <p>Empezamos por una llamada gratuita de 15 minutos. Si no encaja, te lo digo.</p>
    </div>
    <div class="steps case-needs">
      {page.needs.map(([name, text]) => (
        <article>
          <h3>{name}</h3>
          <p>{text}</p>
        </article>
      ))}
    </div>
  </section>

  <section id="faq" class="section">
    <div class="section-head"><span class="eyebrow">Preguntas frecuentes</span><h2>Dudas habituales</h2></div>
    <div class="faq-list">{page.faq.map(([q, a]) => <details><summary>{q}</summary><p>{a}</p></details>)}</div>
  </section>

  <section class="section">
    <div class="section-head"><span class="eyebrow">Más casos prácticos</span><h2>Otros casos</h2></div>
    <div class="tag-grid">
      {others.map((item) => <a class="btn btn-secondary" href={`/casos/${item.slug}/`}>{item.h1.replace(/\.$/, "")}</a>)}
      <a class="btn btn-secondary" href="/casos/">Ver todos los casos</a>
    </div>
    <p class="muted case-related">
      También te puede interesar:
      {page.related.map(([label, href], index) => <>{index > 0 ? " · " : " "}<a class="text-link" href={href}>{label}</a></>)}
    </p>
  </section>

  <ContactForm selectedService={page.formService} title={page.finalCta} />
</BaseLayout>

<style>
  .case-offers {
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  }

  .case-needs {
    grid-template-columns: 1fr;
  }

  .case-related {
    margin-top: 22px;
  }
</style>

---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ContactForm from "@/components/ContactForm.astro";
import { siteConfig } from "@/config/site";
import { casePages, entryOffer, formatEuro } from "@/data/casePages";

const title = "Casos prácticos de automatización e IA para PyMEs | Taller de Digitalización";
const description =
  "Trabajos concretos de automatización e IA ya hechos en empresas reales, explicados con palabras simples y con el precio para llevarlos a la tuya.";
const pageUrl = new URL("/casos/", siteConfig.publicUrl).toString();

const extraSchema = [
  {
    "@type": "CollectionPage",
    "@id": `${pageUrl}#page`,
    url: pageUrl,
    name: "Casos prácticos de Taller de Digitalización",
    description,
    mainEntity: {
      "@type": "ItemList",
      itemListElement: casePages.map((item, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: item.h1.replace(/\.$/, ""),
        url: new URL(`/casos/${item.slug}/`, siteConfig.publicUrl).toString(),
      })),
    },
  },
  {
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Inicio", item: `${siteConfig.publicUrl}/` },
      { "@type": "ListItem", position: 2, name: "Casos prácticos", item: pageUrl },
    ],
  },
];

const navItems = [
  ["Casos", "#casos"],
  ["Cómo trabajo", "#como"],
  ["Contacto", "#contacto"],
];

const faq: [string, string][] = [
  ["¿Qué son los casos prácticos?", "Son trabajos concretos de automatización e IA que ya he hecho en empresas reales, explicados con palabras simples. Cada uno se puede llevar a otra empresa y tiene su precio."],
  ["¿Solo sirven para empresas de telecomunicaciones?", "No. Los casos salen de operadores de telecomunicaciones, que es mi nicho, pero las ideas valen para cualquier empresa de hasta 50 personas con proveedores, facturas, datos dispersos y programas que se hablan poco entre sí."],
  ["¿Por qué muestras los precios?", "Porque prefiero que veas qué hago y cuánto cuesta antes de hablar conmigo. El precio final te lo doy cerrado tras una primera revisión."],
  ["¿Y si lo que necesito no está aquí?", "Cuéntamelo. Estos son los primeros casos y es fácil que lo tuyo se parezca a alguno."],
];
---

<BaseLayout title={title} description={description} canonicalPath="/casos" faq={faq} extraSchema={extraSchema} headerNavItems={navItems}>
  <section class="hero">
    <div class="hero-content">
      <span class="eyebrow">Casos prácticos</span>
      <h1>Automatizaciones que ya funcionan en empresas reales.</h1>
      <p class="hero-subtitle">Trabajos concretos de automatización e inteligencia artificial, explicados con palabras simples: qué problema había, cómo se resolvió y cuánto costaría llevarlo a tu empresa.</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="#casos">Ver los casos</a>
        <a class="btn btn-secondary" data-event="reservar_click" data-preserve-utm href={siteConfig.bookingUrl} target="_blank" rel="noreferrer">Reservar llamada gratuita</a>
      </div>
    </div>
  </section>

  <section id="casos" class="section">
    <div class="section-head">
      <span class="eyebrow">Casos</span>
      <h2>Cuatro casos, con su precio.</h2>
      <p>Precios sin IVA. Cada caso explica el problema, la solución y lo que costaría llevarlo a tu empresa.</p>
    </div>
    <div class="product-grid lab-grid">
      {casePages.map((item) => {
        const entry = entryOffer(item);
        return (
          <article class="product-card">
            <span class="eyebrow">Caso práctico</span>
            <h3>{item.h1.replace(/\.$/, "")}</h3>
            <p>{item.summary}</p>
            <p class="price-tag">{entry.fixed ? "" : "Desde "}<strong>{formatEuro(entry.price)}</strong> + IVA</p>
            <a class="btn btn-primary" href={`/casos/${item.slug}/`}>Ver el caso</a>
          </article>
        );
      })}
    </div>
  </section>

  <section class="section section-accent">
    <div class="section-head">
      <span class="eyebrow">La idea de fondo</span>
      <h2>Que lo que hoy exige abrir cinco programas se pida con una frase.</h2>
      <p>Cada caso resuelve un trozo de la misma cadena, de la venta a la factura: consultar datos, cruzar lo que pagas con lo que tienes, meter facturas, saber qué se puede ofrecer a un cliente. En lugar de una aplicación nueva para cada cosa, la IA se conecta a lo que ya existe y se le pide en lenguaje normal, también desde el móvil.</p>
      <p>Y lo que se monta una vez hay que mantenerlo: por eso cada caso termina en un <a class="text-link" href="/plan-operaciones-ia/">plan mensual de operaciones e IA</a>.</p>
    </div>
  </section>

  <section id="como" class="section">
    <div class="section-head">
      <span class="eyebrow">Cómo trabajo</span>
      <h2>Sin vender humo y con las decisiones en tus manos.</h2>
    </div>
    <div class="steps steps-4">
      <article>
        <span class="step-number">1</span>
        <h3>Llamada gratuita</h3>
        <p>15 minutos para ver si tu caso se parece a alguno de estos. Si no encaja, te lo digo.</p>
      </article>
      <article>
        <span class="step-number">2</span>
        <h3>Propuesta cerrada</h3>
        <p>Qué se hace, cuánto cuesta y qué no entra, antes de empezar.</p>
      </article>
      <article>
        <span class="step-number">3</span>
        <h3>Montaje</h3>
        <p>Lo construyo con tus datos y tus accesos. Lo que cuesta dinero o no se deshace lo confirma una persona.</p>
      </article>
      <article>
        <span class="step-number">4</span>
        <h3>Plan mensual</h3>
        <p>Si quieres que siga funcionando y mejorando, un plan mensual, desde 39 €/mes según lo que haya que mantener.</p>
      </article>
    </div>
  </section>

  <section id="faq" class="section">
    <div class="section-head"><span class="eyebrow">Preguntas frecuentes</span><h2>Dudas habituales</h2></div>
    <div class="faq-list">{faq.map(([q, a]) => <details><summary>{q}</summary><p>{a}</p></details>)}</div>
  </section>

  <ContactForm selectedService="Otro" title="¿Tienes un caso parecido? Cuéntamelo." />
</BaseLayout>

<style>
  .lab-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  @media (max-width: 760px) {
    .lab-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

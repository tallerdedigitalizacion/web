---
import ServiceLanding from "@/components/ServiceLanding.astro";
import { siteConfig } from "@/config/site";
import { withBase } from "@/utils/paths";

const sections = [
  {
    id: "what-it-includes",
    eyebrow: "What it includes",
    heading: "Everything connected, nothing lost.",
    variant: "tag" as const,
    items: [
      "Form integration",
      "CRM automation",
      "Automatic classification",
      "Assignment by team",
      "Notifications",
      "Status tracking for every opportunity",
    ],
  },
  {
    id: "benefits",
    eyebrow: "Benefits",
    heading: "What your sales team gains.",
    variant: "check" as const,
    items: [
      "No lead gets lost",
      "Faster response times",
      "Better sales organization",
      "Centralized information",
    ],
  },
];
---

<ServiceLanding
  lang="en"
  title="Lead Centralization | Taller de Digitalización"
  description="We centralize incoming leads from every channel so information reaches your CRM automatically and your team can act fast."
  slug="/lead-centralization"
  schemaDescription="Lead centralization: form integration, CRM automation, automatic classification and team assignment."
  schemaAreaServed={["United States", "Remote"]}
  eyebrow="Lead Centralization"
  h1="All your prospects in a single place."
  subtitleParagraphs={[
    "Contacts come in from your website, social media, forms, campaigns or WhatsApp. When each channel works on its own, opportunities get lost.",
    "We centralize incoming leads so all the information reaches your CRM automatically and your team can act fast.",
  ]}
  sections={sections}
  finalCtaHeading="Turn every contact into a business opportunity."
  leadMagnetNav={["Calculator", "#calculator"]}
>
  <section slot="lead-magnet" id="calculator" class="section section-accent">
    <div class="section-head">
      <span class="eyebrow">Free calculator</span>
      <h2>How much are the leads you lose actually costing you?</h2>
      <p>A quick estimate based on your own numbers, not industry averages. Move the controls and see the result instantly.</p>
    </div>
    <div class="lead-capture">
      <div class="form-grid">
        <label>Leads you get per month<input type="number" min="0" step="1" value="50" data-calc-input="leadsPerMonth" /></label>
        <label>Average customer value ($)<input type="number" min="0" step="10" value="500" data-calc-input="avgDealValue" /></label>
      </div>
      <div class="question">
        <p>% you estimate is lost or contacted too late</p>
        <div class="range-answer">
          <strong data-calc-label="lostPercentage">30%</strong>
          <input type="range" min="0" max="80" step="5" value="30" data-calc-input="lostPercentage" />
        </div>
      </div>
      <div class="question">
        <p>Usual close rate on leads you contact in time</p>
        <div class="range-answer">
          <strong data-calc-label="closeRate">20%</strong>
          <input type="range" min="0" max="50" step="5" value="20" data-calc-input="closeRate" />
        </div>
      </div>

      <div class="result-panel" data-calc-result>
        <div class="result-summary">
          <div>
            <span class="eyebrow">Estimate</span>
            <h3><span data-calc-out="lostLeadsPerMonth">7.5</span> lost leads per month</h3>
            <p class="muted">Roughly <strong>$<span data-calc-out="lostRevenuePerMonth">750</span>/month</strong> ($<span data-calc-out="lostRevenuePerYear">9,000</span>/year) in opportunities that are not captured or followed up in time.</p>
          </div>
        </div>
      </div>

      <form class="compact-form" data-calc-form>
        <label>Name<input required name="nombre" autocomplete="name" /></label>
        <label>Email<input required type="email" name="email" autocomplete="email" /></label>
        <label>Company<input name="empresa" autocomplete="organization" /><small>Optional.</small></label>
        <label class="check"><input required type="checkbox" name="privacidad" /> <span>I accept the <a href={withBase("/politica-privacidad")} target="_blank" rel="noreferrer">privacy policy</a>.</span></label>
        <label class="honeypot" aria-hidden="true">Website<input tabindex="-1" autocomplete="off" name="website" /></label>
        <input type="hidden" name="started_at" data-started-at />
        <button class="btn btn-primary" type="submit" data-event="calculadora_leads_click">Email me this summary</button>
        <p class="form-help" data-calc-status aria-live="polite"></p>
      </form>
    </div>
  </section>
</ServiceLanding>

<script define:vars={{ formEndpoint: siteConfig.formEndpoint }}>
  function apiBaseUrl() {
    if (!formEndpoint || formEndpoint.includes("INSERTAR")) return "";
    return String(formEndpoint).replace(/\/$/, "");
  }

  async function postLead(path, payload) {
    const baseUrl = apiBaseUrl();
    if (!baseUrl) throw new Error("Form endpoint not configured.");
    const response = await fetch(`${baseUrl}/lead/${path}`, {
      method: "POST",
      headers: { "content-type": "application/json" },
      body: JSON.stringify(payload),
    });
    const data = await response.json().catch(() => ({}));
    if (!response.ok || data.ok === false) throw new Error(data.error || "Could not process the request.");
    return data;
  }

  const numberFormatter = new Intl.NumberFormat("en-US", { maximumFractionDigits: 0 });
  const calcInputs = [...document.querySelectorAll("[data-calc-input]")];

  function currentValues() {
    const values = {};
    calcInputs.forEach((input) => {
      values[input.dataset.calcInput] = Number(input.value) || 0;
    });
    return values;
  }

  function calculate() {
    const { leadsPerMonth, avgDealValue, lostPercentage, closeRate } = currentValues();
    const lostLeadsPerMonth = leadsPerMonth * (lostPercentage / 100);
    const lostRevenuePerMonth = lostLeadsPerMonth * (closeRate / 100) * avgDealValue;
    const lostRevenuePerYear = lostRevenuePerMonth * 12;
    return { leadsPerMonth, avgDealValue, lostPercentage, closeRate, lostLeadsPerMonth, lostRevenuePerMonth, lostRevenuePerYear };
  }

  function render() {
    const results = calculate();
    document.querySelectorAll("[data-calc-label]").forEach((el) => {
      const key = el.dataset.calcLabel;
      if (key in results) el.textContent = `${numberFormatter.format(results[key])}%`;
    });
    const out = document.querySelectorAll("[data-calc-out]");
    out.forEach((el) => {
      const key = el.dataset.calcOut;
      if (key === "lostLeadsPerMonth") el.textContent = numberFormatter.format(results.lostLeadsPerMonth);
      if (key === "lostRevenuePerMonth") el.textContent = numberFormatter.format(results.lostRevenuePerMonth);
      if (key === "lostRevenuePerYear") el.textContent = numberFormatter.format(results.lostRevenuePerYear);
    });
    return results;
  }

  calcInputs.forEach((input) => input.addEventListener("input", render));
  render();

  document.querySelectorAll("[data-started-at]").forEach((input) => {
    if (input instanceof HTMLInputElement) input.value = String(Date.now());
  });

  document.querySelector("[data-calc-form]")?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const form = event.currentTarget;
    if (!(form instanceof HTMLFormElement)) return;
    const button = form.querySelector("button[type='submit']");
    const status = document.querySelector("[data-calc-status]");
    const formData = new FormData(form);
    const results = calculate();
    if (button instanceof HTMLButtonElement) button.disabled = true;
    if (status instanceof HTMLElement) status.textContent = "Sending...";
    try {
      const response = await postLead("resource", {
        name: String(formData.get("nombre") || ""),
        email: String(formData.get("email") || ""),
        company: String(formData.get("empresa") || ""),
        privacyAccepted: formData.get("privacidad") === "on",
        marketingAccepted: false,
        resourceType: "lead-calculator",
        language: "en",
        calculatorInputs: {
          leadsPerMonth: results.leadsPerMonth,
          lostPercentage: results.lostPercentage,
          closeRate: results.closeRate,
          avgDealValue: results.avgDealValue,
        },
        calculatorResults: {
          lostLeadsPerMonth: Math.round(results.lostLeadsPerMonth * 10) / 10,
          lostRevenuePerMonth: Math.round(results.lostRevenuePerMonth),
          lostRevenuePerYear: Math.round(results.lostRevenuePerYear),
        },
        website: String(formData.get("website") || ""),
        startedAt: Number(formData.get("started_at") || Date.now()),
        pageUrl: window.location.href,
        userAgent: navigator.userAgent,
      });
      if (status instanceof HTMLElement) status.textContent = response.message || "We'll send you the summary by email.";
      form.reset();
      form.querySelectorAll("[data-started-at]").forEach((input) => {
        if (input instanceof HTMLInputElement) input.value = String(Date.now());
      });
      window.tdTrackEvent?.("generate_lead", { lead_type: "lead-calculator" });
    } catch (error) {
      if (status instanceof HTMLElement) status.textContent = error instanceof Error ? error.message : "Could not send the request.";
    } finally {
      if (button instanceof HTMLButtonElement) button.disabled = false;
    }
  });
</script>

---
import ServiceLanding from "@/components/ServiceLanding.astro";

const sections = [
  {
    id: "what-it-can-do",
    eyebrow: "What it can do",
    heading: "A clear answer for every internal question.",
    variant: "tag" as const,
    items: [
      "Look up procedures",
      "Search documentation",
      "Resolve internal questions",
      "Speed up onboarding for new employees",
      "Reduce interruptions between teams",
    ],
  },
  {
    id: "benefits",
    eyebrow: "Benefits",
    heading: "What your team gains.",
    variant: "check" as const,
    items: [
      "Less time spent searching for information",
      "Consistent answers",
      "Higher productivity",
      "Company knowledge is preserved",
    ],
  },
];
---

<ServiceLanding
  lang="en"
  title="AI knowledge base: a chat with your company documents, from $1,200 | Taller de Digitalización"
  description="An AI knowledge base for your team: a chat that answers questions using only your company's own documents and information."
  slug="/ai-knowledge-base"
  schemaDescription="AI knowledge base: an AI assistant that answers internal questions using the company's documentation."
  schemaAreaServed={["United States", "Remote"]}
  eyebrow="AI knowledge base for your company documents"
  h1="Your company's knowledge, available in seconds."
  subtitleParagraphs={[
    "Procedures, manuals, documentation and FAQs are usually scattered across folders, emails and documents.",
    "The AI knowledge base answers questions based solely on your company's own information.",
  ]}
  sections={sections}
  finalCtaHeading="The right information, at the right moment."
/>

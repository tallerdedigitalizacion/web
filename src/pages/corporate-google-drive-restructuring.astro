---
import ServiceLanding from "@/components/ServiceLanding.astro";
import { siteConfig } from "@/config/site";
import { withBase } from "@/utils/paths";

const sections = [
  {
    id: "what-it-includes",
    eyebrow: "What it includes",
    heading: "A structure built to last.",
    variant: "tag" as const,
    items: [
      "Folder organization",
      "Shared drives",
      "Permissions",
      "Duplicate removal",
      "Structure by department",
      "Collaboration best practices",
    ],
  },
  {
    id: "benefits",
    eyebrow: "Benefits",
    heading: "What changes with a clear structure.",
    variant: "check" as const,
    items: [
      "Less time spent searching for documents",
      "Better collaboration",
      "Lower risk of information loss",
      "More control over access",
    ],
  },
];
---

<ServiceLanding
  lang="en"
  title="Corporate Google Drive Restructuring | Taller de Digitalización"
  description="We design a clear, scalable and easy-to-maintain structure for Google Drive so the whole business works on a single organization."
  slug="/corporate-google-drive-restructuring"
  schemaDescription="Corporate Google Drive restructuring: folders, shared drives, permissions and duplicate removal."
  schemaAreaServed={["United States", "Remote"]}
  eyebrow="Corporate Google Drive Restructuring"
  h1="Find any document in seconds."
  subtitleParagraphs={[
    "When files are scattered across personal folders, shared drives and duplicate documents, finding information becomes a constant waste of time.",
    "We design a clear, scalable and easy-to-maintain structure so the whole business works on a single organization.",
  ]}
  sections={sections}
  finalCtaHeading="Turn Google Drive into a working tool, not a file dump."
  leadMagnetNav={["Free template", "#template"]}
>
  <section slot="lead-magnet" id="template" class="section section-accent">
    <div class="section-head">
      <span class="eyebrow">Free template</span>
      <h2>Start with the structure already built, not from scratch.</h2>
      <p>A folder template by department, with suggested permission tiers and best practices, ready to copy into your Google Drive.</p>
    </div>
    <div class="lead-capture">
      <form class="compact-form" data-resource-form data-resource-type="drive-template" data-language="en">
        <label>Name<input required name="nombre" autocomplete="name" /></label>
        <label>Email<input required type="email" name="email" autocomplete="email" /></label>
        <label>Company<input name="empresa" autocomplete="organization" /><small>Optional.</small></label>
        <label class="check"><input required type="checkbox" name="privacidad" /> <span>I accept the <a href={withBase("/politica-privacidad")} target="_blank" rel="noreferrer">privacy policy</a>.</span></label>
        <label class="honeypot" aria-hidden="true">Website<input tabindex="-1" autocomplete="off" name="website" /></label>
        <input type="hidden" name="started_at" data-started-at />
        <button class="btn btn-primary" type="submit" data-event="plantilla_drive_click">Download the free template</button>
        <p class="form-help" data-resource-status aria-live="polite">We'll send it to your email.</p>
      </form>
    </div>
  </section>
</ServiceLanding>

<script define:vars={{ formEndpoint: siteConfig.formEndpoint }}>
  function apiBaseUrl() {
    if (!formEndpoint || formEndpoint.includes("INSERTAR")) return "";
    return String(formEndpoint).replace(/\/$/, "");
  }

  async function postLead(path, payload) {
    const baseUrl = apiBaseUrl();
    if (!baseUrl) throw new Error("Form endpoint not configured.");
    const response = await fetch(`${baseUrl}/lead/${path}`, {
      method: "POST",
      headers: { "content-type": "application/json" },
      body: JSON.stringify(payload),
    });
    const data = await response.json().catch(() => ({}));
    if (!response.ok || data.ok === false) throw new Error(data.error || "Could not process the request.");
    return data;
  }

  document.querySelectorAll("[data-started-at]").forEach((input) => {
    if (input instanceof HTMLInputElement) input.value = String(Date.now());
  });

  document.querySelector("[data-resource-form]")?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const form = event.currentTarget;
    if (!(form instanceof HTMLFormElement)) return;
    const button = form.querySelector("button[type='submit']");
    const status = document.querySelector("[data-resource-status]");
    const formData = new FormData(form);
    if (button instanceof HTMLButtonElement) button.disabled = true;
    if (status instanceof HTMLElement) status.textContent = "Sending...";
    try {
      const response = await postLead("resource", {
        name: String(formData.get("nombre") || ""),
        email: String(formData.get("email") || ""),
        company: String(formData.get("empresa") || ""),
        privacyAccepted: formData.get("privacidad") === "on",
        marketingAccepted: false,
        resourceType: form.dataset.resourceType,
        language: form.dataset.language,
        website: String(formData.get("website") || ""),
        startedAt: Number(formData.get("started_at") || Date.now()),
        pageUrl: window.location.href,
        userAgent: navigator.userAgent,
      });
      if (status instanceof HTMLElement) status.textContent = response.message || "We'll send it to your email.";
      form.reset();
      form.querySelectorAll("[data-started-at]").forEach((input) => {
        if (input instanceof HTMLInputElement) input.value = String(Date.now());
      });
      window.tdTrackEvent?.("generate_lead", { lead_type: form.dataset.resourceType });
    } catch (error) {
      if (status instanceof HTMLElement) status.textContent = error instanceof Error ? error.message : "Could not send the request.";
    } finally {
      if (button instanceof HTMLButtonElement) button.disabled = false;
    }
  });
</script>

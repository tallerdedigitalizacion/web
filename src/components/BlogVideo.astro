---
// Vídeo de YouTube de un artículo del blog. Se pinta una fachada (miniatura + botón) y el reproductor
// de youtube-nocookie.com solo se carga al hacer clic, para no gastar datos ni enviar cookies antes de tiempo.
// Sin JavaScript, la fachada es un enlace al vídeo en YouTube.
const { videoId, title } = Astro.props as { videoId: string; title: string };
---

<div class="blog-video" data-video-id={videoId} data-video-title={title}>
  <a
    class="blog-video-facade"
    href={`https://www.youtube.com/watch?v=${videoId}`}
    aria-label={`Reproducir vídeo: ${title}`}
    target="_blank"
    rel="noopener"
  >
    <img src={`https://i.ytimg.com/vi/${videoId}/hqdefault.jpg`} alt="" width="480" height="360" loading="lazy" decoding="async" />
    <span class="blog-video-play" aria-hidden="true"></span>
  </a>
</div>

<script>
  document.querySelectorAll<HTMLElement>(".blog-video[data-video-id]").forEach((frame) => {
    frame.querySelector("a")?.addEventListener("click", (event) => {
      event.preventDefault();
      const iframe = document.createElement("iframe");
      const params = new URLSearchParams({ autoplay: "1", rel: "0", playsinline: "1" });
      iframe.src = `https://www.youtube-nocookie.com/embed/${frame.dataset.videoId}?${params}`;
      iframe.title = frame.dataset.videoTitle ?? "Vídeo";
      iframe.allow = "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; fullscreen";
      iframe.allowFullscreen = true;
      iframe.referrerPolicy = "strict-origin-when-cross-origin";
      frame.replaceChildren(iframe);
      iframe.focus();
    });
  });
</script>

<style>
  .blog-video {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    margin: 20px 0 28px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--dark);
    box-shadow: var(--shadow);
    overflow: hidden;
  }

  .blog-video-facade {
    position: absolute;
    inset: 0;
    display: block;
  }

  /* hqdefault es 4:3 con franjas negras: se recorta para llenar el 16:9. */
  .blog-video-facade img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .blog-video-play {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 68px;
    height: 48px;
    transform: translate(-50%, -50%);
    border-radius: 12px;
    background: rgba(0, 0, 0, 0.78);
  }

  .blog-video-play::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-35%, -50%);
    border-style: solid;
    border-width: 10px 0 10px 18px;
    border-color: transparent transparent transparent #fff;
  }

  .blog-video-facade:hover .blog-video-play,
  .blog-video-facade:focus-visible .blog-video-play {
    background: #c00;
  }

  /* El iframe se crea con JS, por eso necesita :global (los estilos de Astro son por componente). */
  .blog-video :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>

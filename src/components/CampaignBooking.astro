---
// Reserva de la llamada DENTRO de la página, con el código oficial «inline embed» de Cal.com (script de incrustado).
//
// Consentimiento: el script y el calendario son de un tercero (Cal.com), así que no se cargan al abrir la página.
//  - Si la persona ya aceptó las cookies (o las acepta mientras está en la página), el calendario aparece solo, sin botón.
//  - Si no, ve un botón «Ver huecos disponibles»: al pulsarlo se carga. Sin autoplay de nada.
// Medición: el botón y el enlace de respaldo disparan `reservar_click` (CookieBanner). Al completarse la reserva, Cal.com avisa
// a la página (`bookingSuccessful`), que lanza `reserva_completada` y muestra la confirmación; no hace falta la página de gracias.
// Atribución: la reserva se hace en un iframe de Cal.com, así que la atribución viaja con ella como `metadata[...]` (utm_*, gclid,
// landing y ref) y Cal.com la devuelve en el payload del webhook BOOKING_CREATED, que la guarda en el CRM (backend/src/calWebhook.ts).
// Sale de `window.tdAttribution()` (URL y, con consentimiento analítico, sessionStorage), igual que en los formularios.
import type { Lang } from "@/data/campaigns";
import { shared } from "@/data/campaigns";

interface Props {
  lang: Lang;
  calLink: string;
  calNamespace: string;
}

const { lang, calLink, calNamespace } = Astro.props as Props;
const copy = shared[lang].booking;
const mountId = `cal-inline-${calNamespace}`;
---

<section id="reserva" class="section section-accent" data-booking data-cal-link={calLink} data-cal-ns={calNamespace} data-mount={mountId} data-lang={lang}>
  <div class="section-head">
    <span class="eyebrow">{copy.eyebrow}</span>
    <h2>{copy.title}</h2>
    <p>{copy.intro}</p>
  </div>
  <div class="cb-box">
    <div class="cb-facade" data-booking-facade>
      <button class="btn btn-primary" type="button" data-event="reservar_click" data-link-id="booking-embed-open" data-booking-open>{copy.openLabel}</button>
      <p class="microcopy">{copy.consentNote}</p>
      <a class="cb-fallback" data-event="reservar_click" data-link-id="booking-fallback" href={`https://cal.com/${calLink}`} target="_blank" rel="noreferrer">{copy.fallbackLabel}</a>
    </div>
    <p class="microcopy" data-booking-loading hidden>{copy.loadingLabel}</p>
    <div class="cb-cal" id={mountId} data-booking-mount hidden></div>
  </div>
  <div class="cb-done" data-booking-done role="status" hidden>
    <h3>{copy.confirmedTitle}</h3>
    <p>{copy.confirmedText}</p>
  </div>
</section>

<script>
  type CalFn = ((...args: unknown[]) => void) & { ns?: Record<string, (...args: unknown[]) => void>; config?: Record<string, unknown> };
  type TdWindow = Window & {
    Cal?: CalFn;
    tdConsent?: { analytics?: boolean; marketing?: boolean };
    tdTrackEvent?: (name: string, params?: Record<string, unknown>) => void;
    tdAttribution?: () => { source?: string; medium?: string; campaign?: string; content?: string; term?: string; clickId?: string; clickIdType?: string; landing?: string } | undefined;
  };
  const w = window as TdWindow;

  const root = document.querySelector<HTMLElement>("[data-booking]");
  if (root) {
    const facade = root.querySelector<HTMLElement>("[data-booking-facade]");
    const loading = root.querySelector<HTMLElement>("[data-booking-loading]");
    const mount = root.querySelector<HTMLElement>("[data-booking-mount]");
    const done = root.querySelector<HTMLElement>("[data-booking-done]");
    const open = root.querySelector<HTMLButtonElement>("[data-booking-open]");
    let started = false;
    let completed = false;

    // Atribución de esta visita como metadata de la reserva. Cal.com admite hasta 500 caracteres por valor; un gclid cabe de sobra.
    function bookingMetadata() {
      const a = w.tdAttribution?.();
      const metadata: Record<string, string> = {};
      if (!a) return metadata;
      const set = (key: string, value?: string) => { if (value) metadata[`metadata[${key}]`] = value.slice(0, 255); };
      set("utm_source", a.source);
      set("utm_medium", a.medium);
      set("utm_campaign", a.campaign);
      set("utm_content", a.content);
      set("utm_term", a.term);
      if (a.clickIdType === "gclid" || a.clickIdType === "gbraid" || a.clickIdType === "wbraid") set(a.clickIdType, a.clickId);
      set("landing", a.landing);
      // Mismo código que el texto prellenado de WhatsApp: <source>/<campaña>[/<anuncio>].
      if (a.source && (a.medium || a.campaign || a.content || a.term)) {
        set("ref", [a.source, a.campaign || a.medium, a.content].filter(Boolean).join("/").replace(/[^\w/.-]/g, "").slice(0, 60));
      }
      return metadata;
    }

    // Parámetros del evento: la atribución solo se añade con consentimiento (analítica o marketing).
    function completionParams() {
      const params: Record<string, unknown> = {
        lead_type: "booking",
        language: root?.dataset.lang || document.documentElement.lang || "es",
        page_path: window.location.pathname,
        page_location: window.location.href,
      };
      if (w.tdConsent?.analytics || w.tdConsent?.marketing) {
        const a = w.tdAttribution?.();
        if (a) {
          if (a.source) params.utm_source = a.source;
          if (a.medium) params.utm_medium = a.medium;
          if (a.campaign) params.utm_campaign = a.campaign;
          if (a.content) params.utm_content = a.content;
          if (a.term) params.utm_term = a.term;
          if (a.clickIdType === "gclid" && a.clickId) params.gclid = a.clickId;
        }
      }
      return params;
    }

    function startCal() {
      if (started || !root || !facade || !mount) return;
      started = true;
      const ns = root.dataset.calNs || "";
      const link = root.dataset.calLink || "";
      facade.hidden = true;
      mount.hidden = false;
      if (loading) loading.hidden = false;

      // Código oficial de Cal.com (cargador del script de incrustado).
      (function (C: any, A: string, L: string) {
        const p = function (a: any, ar: any) { a.q.push(ar); };
        const d = C.document;
        C.Cal = C.Cal || function () {
          const cal = C.Cal;
          const ar = arguments;
          if (!cal.loaded) {
            cal.ns = {};
            cal.q = cal.q || [];
            d.head.appendChild(d.createElement("script")).src = A;
            cal.loaded = true;
          }
          if (ar[0] === L) {
            const api: any = function () { p(api, arguments); };
            const namespace = ar[1];
            api.q = api.q || [];
            if (typeof namespace === "string") {
              cal.ns[namespace] = cal.ns[namespace] || api;
              p(cal.ns[namespace], ar);
              p(cal, ["initNamespace", namespace]);
            } else p(cal, ar);
            return;
          }
          p(cal, ar);
        };
      })(window, "https://app.cal.com/embed/embed.js", "init");

      const Cal = w.Cal as CalFn;
      Cal("init", ns, { origin: "https://app.cal.com" });
      Cal.config = Cal.config || {};
      Cal.config.forwardQueryParams = true;
      const api = (Cal.ns as Record<string, (...args: unknown[]) => void>)[ns];
      api("inline", {
        elementOrSelector: `#${mount.id}`,
        config: { layout: "month_view", useSlotsViewOnSmallScreen: "true", theme: "dark", ...bookingMetadata() },
        calLink: link,
      });
      api("ui", { theme: "dark", hideEventTypeDetails: false, layout: "month_view", styles: { branding: { brandColor: "#4ee58d" } } });
      api("on", { action: "linkReady", callback: () => { if (loading) loading.hidden = true; } });
      api("on", {
        action: "bookingSuccessful",
        callback: () => {
          // Una sola vez por reserva: Cal.com puede avisar más de una vez. No se lanza generate_lead (la reserva se cuenta aparte).
          if (!completed) {
            completed = true;
            w.tdTrackEvent?.("reserva_completada", completionParams());
          }
          if (mount) mount.hidden = true;
          if (loading) loading.hidden = true;
          if (done) done.hidden = false;
        },
      });
    }

    open?.addEventListener("click", startCal);
    // Con las cookies aceptadas (ya guardadas o aceptadas ahora) el calendario aparece solo.
    if (w.tdConsent?.analytics || w.tdConsent?.marketing) startCal();
    window.addEventListener("td:consent", (event) => {
      const consent = (event as CustomEvent<{ analytics?: boolean; marketing?: boolean }>).detail;
      if (consent?.analytics || consent?.marketing) startCal();
    });
  }
</script>

<style>
  .cb-box {
    display: grid;
    justify-items: start;
    gap: 12px;
    max-width: 860px;
  }

  .cb-facade {
    display: grid;
    justify-items: start;
    gap: 12px;
  }

  .cb-box .microcopy { margin: 0; }
  .cb-fallback { color: var(--muted); font-size: 0.95rem; }
  .cb-fallback:hover { color: var(--ink); }

  .cb-cal {
    width: 100%;
    min-height: 560px;
    overflow: auto;
  }

  .cb-done {
    max-width: 860px;
    padding: 22px;
    border: 1px solid var(--accent);
    border-radius: var(--radius);
    background: var(--paper);
  }

  .cb-done h3, .cb-done p { margin: 0 0 8px; }
</style>

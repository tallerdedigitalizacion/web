---
import { reviews } from "@/data/reviews";
import { siteConfig } from "@/config/site";

interface Props {
  lang?: "es" | "en";
  limit?: number;
}

const { lang = "es", limit } = Astro.props as Props;
const isEnglish = lang === "en";

const translateDate = (date: string) => date.replace(/^Hace (\d+) mes(es)?$/, (_, count) => `${count} month${count === "1" ? "" : "s"} ago`);
const displayReviews = reviews.slice(0, limit).map((review) => (isEnglish ? { ...review, date: translateDate(review.date) } : review));
---

<div class="reviews-carousel" data-reviews-carousel aria-label={isEnglish ? "Google reviews" : "Reseñas de Google"}>
  <div class="reviews-track" data-reviews-track>
    {displayReviews.map((review, index) => (
      <article class="review-card" data-review-card aria-label={`${isEnglish ? "Review" : "Reseña"} ${index + 1} ${isEnglish ? "of" : "de"} ${displayReviews.length}`}>
        <div class="review-meta">
          <strong>{review.name}</strong>
          <a class="review-source" href={siteConfig.googleBusinessUrl} target="_blank" rel="noreferrer">
            <svg class="google-mark" aria-hidden="true" viewBox="0 0 24 24" width="16" height="16">
              <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.76h3.56c2.08-1.92 3.28-4.74 3.28-8.09Z"/>
              <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.56-2.76c-.98.66-2.24 1.06-3.72 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84A11 11 0 0 0 12 23Z"/>
              <path fill="#FBBC05" d="M5.84 14.11a6.61 6.61 0 0 1 0-4.22V7.05H2.18a11 11 0 0 0 0 9.9l3.66-2.84Z"/>
              <path fill="#EA4335" d="M12 5.36c1.62 0 3.06.56 4.21 1.64l3.15-3.15A10.56 10.56 0 0 0 12 1 11 11 0 0 0 2.18 7.05l3.66 2.84C6.71 7.29 9.14 5.36 12 5.36Z"/>
            </svg>
            {isEnglish ? `Translated Google review · ${review.rating}/5 · ${review.date}` : `${review.source} · ${review.rating}/5 · ${review.date}`}
          </a>
        </div>
        <p>{isEnglish ? review.textEn : review.text}</p>
      </article>
    ))}
  </div>
  <div class="carousel-controls">
    <button class="btn btn-secondary btn-small" type="button" data-review-prev aria-label={isEnglish ? "View previous review" : "Ver reseña anterior"}>{isEnglish ? "Previous" : "Anterior"}</button>
    <div class="carousel-dots" data-review-dots aria-label={isEnglish ? "Review indicator" : "Indicador de reseñas"}></div>
    <button class="btn btn-secondary btn-small" type="button" data-review-next aria-label={isEnglish ? "View next review" : "Ver reseña siguiente"}>{isEnglish ? "Next" : "Siguiente"}</button>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-reviews-carousel]").forEach((carousel) => {
    const track = carousel.querySelector<HTMLElement>("[data-reviews-track]");
    const cards = [...carousel.querySelectorAll<HTMLElement>("[data-review-card]")];
    const prev = carousel.querySelector("[data-review-prev]");
    const next = carousel.querySelector("[data-review-next]");
    const dots = carousel.querySelector<HTMLElement>("[data-review-dots]");
    if (!track || !dots || cards.length === 0) return;

    let activeReview = 0;
    let scrollTimer: number | undefined;

    dots.innerHTML = cards
      .map((_, index) => `<button type="button" aria-label="${index + 1}" data-review-dot="${index}"></button>`)
      .join("");

    function setActiveReview(index: number) {
      activeReview = (index + cards.length) % cards.length;
      dots?.querySelectorAll("[data-review-dot]").forEach((dot) => {
        dot.toggleAttribute("aria-current", dot.getAttribute("data-review-dot") === String(activeReview));
      });
    }

    function showReview(index: number) {
      setActiveReview(index);
      track?.scrollTo({ left: cards[activeReview].offsetLeft - (track?.offsetLeft ?? 0), behavior: "smooth" });
    }

    function syncReviewFromScroll() {
      const trackLeft = track!.getBoundingClientRect().left;
      const nearestIndex = cards.reduce((nearest, card, index) => {
        const currentDistance = Math.abs(card.getBoundingClientRect().left - trackLeft);
        const nearestDistance = Math.abs(cards[nearest].getBoundingClientRect().left - trackLeft);
        return currentDistance < nearestDistance ? index : nearest;
      }, 0);
      setActiveReview(nearestIndex);
    }

    setActiveReview(0);

    track.addEventListener("scroll", () => {
      window.clearTimeout(scrollTimer);
      scrollTimer = window.setTimeout(syncReviewFromScroll, 80);
    });
    prev?.addEventListener("click", () => showReview(activeReview - 1));
    next?.addEventListener("click", () => showReview(activeReview + 1));
    dots.addEventListener("click", (event) => {
      const dot = event.target instanceof Element ? event.target.closest<HTMLElement>("[data-review-dot]") : null;
      if (dot) showReview(Number(dot.dataset.reviewDot));
    });
  });
</script>

---
import { siteConfig } from "@/config/site";
import { withBase } from "@/utils/paths";

const { lang = "es" } = Astro.props;
const isEnglish = lang === "en";
const serviceLinks = [
  ["Inicio", "/"],
  ["Diagnóstico de caos operativo", "/diagnostico-caos-operativo/"],
  ["Optimización de velocidad web", "/optimizacion-velocidad-web/"],
  ["Informático en Toledo", "/informatico-empresas-toledo/"],
  ["Mantenimiento informático", "/mantenimiento-informatico-toledo/"],
  ["Informático en Fuensalida y Torrijos", "/informatico-fuensalida-torrijos/"],
  ["Consultor de digitalización", "/consultor-digitalizacion-toledo/"],
];
---

<footer class="site-footer">
  <div class="footer-brand">
    <img src={withBase(siteConfig.logo)} alt="Taller de Digitalización" width="48" height="48" loading="lazy" />
    <div>
      <strong>{siteConfig.name}</strong>
      <p>{isEnglish ? "Technical diagnosis and fixes for websites and business operations." : "Soporte informático y digitalización para empresas en Toledo."}</p>
      {!isEnglish && (
        <address>
          {siteConfig.address.streetAddress}, {siteConfig.address.postalCode} {siteConfig.address.addressLocality} ({siteConfig.address.addressRegion})<br />
          <a href={`tel:${siteConfig.phone}`}>{siteConfig.phoneDisplay}</a> · <a href={`mailto:${siteConfig.contactEmail}`}>{siteConfig.contactEmail}</a>
        </address>
      )}
    </div>
  </div>
  {!isEnglish && (
    <nav aria-label="Servicios">
      {serviceLinks.map(([label, href]) => <a href={withBase(href)}>{label}</a>)}
    </nav>
  )}
  <nav aria-label={isEnglish ? "Footer links" : "Enlaces de pie de página"}>
    <a data-event="click_linktree" href={siteConfig.linktreeUrl} target="_blank" rel="noreferrer">{isEnglish ? "Link hub" : "Ver hub de enlaces"}</a>
    <a href={withBase("/aviso-legal")}>{isEnglish ? "Legal notice" : "Aviso legal"}</a>
    <a href={withBase("/politica-privacidad")}>{isEnglish ? "Privacy policy" : "Política de privacidad"}</a>
    <a href={withBase("/politica-cookies")}>{isEnglish ? "Cookie policy" : "Política de cookies"}</a>
  </nav>
</footer>

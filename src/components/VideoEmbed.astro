---
// Vídeo de YouTube que solo se carga cuando la persona pulsa "Reproducir" (no hay peticiones a Google antes).
// Sin videoId no pinta nada: los vídeos se registran en src/data/videos.ts.
const { videoId, title } = Astro.props as { videoId?: string; title: string };
---

{videoId && (
  <>
    <div class="video-frame" data-video-id={videoId} data-video-title={title}>
      <button class="video-play" type="button" aria-label="Reproducir el vídeo">
        <svg aria-hidden="true" viewBox="0 0 24 24" width="34" height="34" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>
        <span>Reproducir vídeo</span>
      </button>
    </div>
    <p class="microcopy video-note">Al reproducirlo se carga el reproductor de YouTube (youtube-nocookie.com).</p>
  </>
)}

<script>
  document.querySelectorAll<HTMLElement>(".video-frame[data-video-id]").forEach((frame) => {
    frame.querySelector("button")?.addEventListener("click", () => {
      const iframe = document.createElement("iframe");
      iframe.src = `https://www.youtube-nocookie.com/embed/${frame.dataset.videoId}?autoplay=1&rel=0`;
      iframe.title = frame.dataset.videoTitle ?? "Vídeo";
      iframe.allow = "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; fullscreen";
      iframe.referrerPolicy = "strict-origin-when-cross-origin";
      frame.replaceChildren(iframe);
    });
  });
</script>

<style>
  .video-frame {
    position: relative;
    width: min(960px, 100%);
    aspect-ratio: 16 / 9;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--dark);
    box-shadow: var(--shadow);
    overflow: hidden;
  }

  /* El iframe se crea con JS, por eso necesita :global (los estilos de Astro son por componente). */
  .video-frame :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .video-play {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 10px;
    width: 100%;
    height: 100%;
    border: 0;
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }

  .video-play svg {
    display: block;
    width: 72px;
    height: 72px;
    padding: 18px 14px 18px 22px;
    border-radius: 50%;
    background: var(--accent);
    color: #20242c;
    box-sizing: border-box;
    transition: transform 0.15s ease;
  }

  .video-play:hover svg {
    transform: scale(1.06);
  }

  .video-note {
    margin-top: 10px;
  }
</style>

---
import { siteConfig } from "@/config/site";

import { withBase } from "@/utils/paths";
import { consentMaxAgeMs, consentStorageKey, consentVersion } from "@/config/consent";

const { lang = "es" } = Astro.props;
const isEnglish = lang === "en";
const hasPixel = Boolean(siteConfig.metaPixelId);
const t = isEnglish
  ? {
      title: "Cookies",
      text: "We use necessary cookies to keep the site working. Without your permission, Google only receives technical signals without cookies. Analytics, the help chat and ad measurement only switch on if you allow them.",
      policy: "Cookie policy",
      necessary: "Necessary.",
      necessaryText: "Required for the site to work. Always active.",
      analytics: "Analytics (Google Analytics).",
      analyticsText: "Anonymous visit statistics to improve the site.",
      chat: "Help chat (Chatbase).",
      chatText: "Automated assistant provided by a third party.",
      marketing: hasPixel ? "Marketing (Google Ads, Meta Pixel)." : "Marketing (Google Ads).",
      marketingText: hasPixel ? "Measures the results of our ads on Google, Facebook and Instagram." : "Measures the results of our ads on Google.",
      reject: "Reject",
      configure: "Configure",
      save: "Save choice",
      acceptAll: "Accept all",
    }
  : {
      title: "Cookies",
      text: "Usamos cookies necesarias para que la web funcione. Sin tu permiso, Google solo recibe señales técnicas sin cookies. Las analíticas, el chat de ayuda y la medición de anuncios solo se activan si las permites.",
      policy: "Política de cookies",
      necessary: "Necesarias.",
      necessaryText: "Imprescindibles para que la web funcione. Siempre activas.",
      analytics: "Analíticas (Google Analytics).",
      analyticsText: "Estadísticas anónimas de visitas para mejorar la web.",
      chat: "Chat de ayuda (Chatbase).",
      chatText: "Asistente automático prestado por un tercero.",
      marketing: hasPixel ? "Marketing (Google Ads, Meta Pixel)." : "Marketing (Google Ads).",
      marketingText: hasPixel ? "Mide los resultados de nuestros anuncios en Google, Facebook e Instagram." : "Mide los resultados de nuestros anuncios en Google.",
      reject: "Rechazar",
      configure: "Configurar",
      save: "Guardar selección",
      acceptAll: "Aceptar todas",
    };
---

<div class="cookie-banner" data-cookie-banner role="dialog" aria-live="polite" aria-label={t.title} hidden>
  <div data-cookie-summary>
    <strong>{t.title}</strong>
    <p>{t.text} <a href={withBase(isEnglish ? "/cookie-policy" : "/politica-cookies")}>{t.policy}</a></p>
  </div>
  <form class="cookie-settings" data-cookie-settings hidden>
    <label class="cookie-option"><input type="checkbox" checked disabled /> <span><strong>{t.necessary}</strong> {t.necessaryText}</span></label>
    <label class="cookie-option"><input type="checkbox" name="analytics" /> <span><strong>{t.analytics}</strong> {t.analyticsText}</span></label>
    <label class="cookie-option"><input type="checkbox" name="chat" /> <span><strong>{t.chat}</strong> {t.chatText}</span></label>
    <label class="cookie-option"><input type="checkbox" name="marketing" /> <span><strong>{t.marketing}</strong> {t.marketingText}</span></label>
  </form>
  <div class="cookie-actions">
    <button class="btn btn-small btn-secondary" type="button" data-cookie-choice="reject">{t.reject}</button>
    <button class="btn btn-small btn-secondary" type="button" data-cookie-open-settings>{t.configure}</button>
    <button class="btn btn-small btn-secondary" type="button" data-cookie-choice="save" hidden>{t.save}</button>
    <button class="btn btn-small btn-secondary" type="button" data-cookie-choice="all">{t.acceptAll}</button>
  </div>
</div>

<script define:vars={{ gaId: siteConfig.googleAnalyticsId, pixelId: siteConfig.metaPixelId, bookingUrls: [siteConfig.bookingUrl, siteConfig.bookingUrlEn], consentKey: consentStorageKey, consentVersion, consentMaxAgeMs }}>
  const banner = document.querySelector("[data-cookie-banner]");
  const settingsForm = document.querySelector("[data-cookie-settings]");
  const eventAliases = {
    click_reservar_llamada: "reservar_click",
    click_telefono: "telefono_click",
  };

  // Eventos propios que se envían a Meta con su nombre estándar (solo si hay consentimiento de marketing).
  const metaEvents = {
    reservar_click: "Schedule",
    generate_lead: "Lead",
    whatsapp_click: "Contact",
    telefono_click: "Contact",
    email_click: "Contact",
  };

  function normalizeEventName(name) {
    return eventAliases[name] || name;
  }

  function getClickEventName(target) {
    const explicitEvent = target.dataset.event;
    if (explicitEvent) return normalizeEventName(explicitEvent);

    const href = target instanceof HTMLAnchorElement ? target.href : "";
    if (href.startsWith("tel:")) return "telefono_click";
    if (href.startsWith("mailto:")) return "email_click";
    if (href.includes("wa.me/")) return "whatsapp_click";
    if (bookingUrls.some((url) => href.startsWith(url))) return "reservar_click";
    return "";
  }

  function getClickEventParams(target) {
    const href = target instanceof HTMLAnchorElement ? target.href : "";
    return {
      link_url: href || undefined,
      link_text: target.textContent?.trim().replace(/\s+/g, " ").slice(0, 120) || undefined,
      link_id: target.dataset.linkId || undefined,
      page_path: window.location.pathname,
      page_location: window.location.href,
    };
  }

  // generate_lead es el evento canónico de conversión: exactamente uno por acción de lead. Si por un fallo
  // (doble clic, doble escuchador) llegara dos veces seguidas con el mismo lead_type, la segunda se descarta.
  const recentLeadEvents = {};

  function trackEvent(name, params = {}) {
    const eventName = normalizeEventName(name);
    if (eventName === "generate_lead") {
      const leadKey = String(params.lead_type || "");
      const now = Date.now();
      if (now - (recentLeadEvents[leadKey] || 0) < 3000) return;
      recentLeadEvents[leadKey] = now;
    }
    window.dataLayer = window.dataLayer || [];
    if (typeof window.gtag === "function") {
      window.gtag("event", eventName, params);
    }
    if (typeof window.fbq === "function" && metaEvents[eventName]) {
      window.fbq("track", metaEvents[eventName]);
    }
  }

  window.tdTrackEvent = trackEvent;

  // Origen de la visita. Orden de prioridad: parámetros de la URL actual, luego el valor persistido (solo con
  // consentimiento analítico) y, si no hay ninguno, el dominio que enlaza. Una visita sin parámetros nunca borra
  // ni sustituye una atribución anterior; solo la sustituye una URL nueva con parámetros (último clic).
  const attributionKey = "td_attribution";
  const clickIdFields = ["gclid", "gbraid", "wbraid"];
  const attributionFields = ["utm_source", "utm_medium", "utm_campaign", "utm_content", "utm_term", ...clickIdFields];

  // Parámetros de atribución de la URL actual. Los identificadores de clic de Google pueden superar los 100
  // caracteres y no se pueden cortar sin invalidarlos.
  function urlTouch() {
    const params = new URLSearchParams(window.location.search);
    const touch = {};
    attributionFields.forEach((key) => {
      const value = params.get(key);
      if (value) touch[key] = value.slice(0, clickIdFields.includes(key) ? 255 : 100);
    });
    return touch;
  }

  function referrerTouch() {
    try {
      const referrer = document.referrer ? new URL(document.referrer).hostname.replace(/^www\./, "") : "";
      if (referrer && referrer !== window.location.hostname.replace(/^www\./, "")) return { referrer };
    } catch {
      // Referrer no válido: se ignora.
    }
    return {};
  }

  function readStoredTouch() {
    try {
      return JSON.parse(sessionStorage.getItem(attributionKey) || "null") || {};
    } catch {
      return {};
    }
  }

  function sameParams(a, b) {
    return attributionFields.every((key) => (a[key] || "") === (b[key] || ""));
  }

  // Origen vigente en esta página. Sin consentimiento analítico no se lee ni se guarda nada: vale la URL actual.
  // Con parámetros en la URL manda la URL entera (nunca se mezclan campos de dos clics distintos).
  function activeTouch() {
    const fromUrl = urlTouch();
    const stored = window.tdConsent?.analytics ? readStoredTouch() : {};
    if (Object.keys(fromUrl).length > 0) {
      const landing = stored.landing && sameParams(stored, fromUrl) ? stored.landing : window.location.pathname;
      return { ...fromUrl, landing };
    }
    if (Object.keys(stored).length > 0) return stored;
    return referrerTouch();
  }

  function captureAttribution() {
    if (!window.tdConsent?.analytics) return;
    const fromUrl = urlTouch();
    const stored = readStoredTouch();
    let touch;
    if (Object.keys(fromUrl).length > 0) {
      // Misma atribución que la guardada: se conserva tal cual (incluida la página de entrada).
      if (Object.keys(stored).length > 0 && sameParams(stored, fromUrl)) return;
      touch = fromUrl;
    } else if (Object.keys(stored).length === 0) {
      touch = referrerTouch();
    }
    if (!touch || Object.keys(touch).length === 0) return;
    try {
      sessionStorage.setItem(attributionKey, JSON.stringify({ ...touch, landing: window.location.pathname }));
    } catch {
      // Sin almacenamiento disponible: se aplica solo a esta página.
    }
  }

  // Origen que se adjunta a los leads (undefined si no hay ninguno). Llega al backend en el campo `attribution`
  // del JSON de cada formulario: es el equivalente de los "campos ocultos" y no depende del consentimiento.
  window.tdAttribution = function tdAttribution() {
    const touch = activeTouch();
    if (Object.keys(touch).length === 0) return undefined;
    const clickIdType = clickIdFields.find((key) => touch[key]);
    return {
      source: touch.utm_source || touch.referrer,
      medium: touch.utm_medium,
      campaign: touch.utm_campaign,
      content: touch.utm_content,
      term: touch.utm_term,
      clickId: clickIdType ? touch[clickIdType] : undefined,
      clickIdType,
      landing: touch.landing || window.location.pathname,
    };
  };

  // El script corre mientras se parsea la página: los enlaces que van después aún no existen.
  function applyAttributionToLinks() {
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", preserveAttributionParams, { once: true });
    } else {
      preserveAttributionParams();
    }
  }

  // Enlaces internos: arrastran los parámetros de atribución de la URL actual (solo la URL, sin guardar nada), de
  // modo que la atribución sobrevive a la navegación aunque no haya consentimiento. Se omiten anclas, descargas y
  // otros dominios.
  function carryParamsToInternalLink(link, params) {
    if (!(link instanceof HTMLAnchorElement)) return;
    const raw = link.getAttribute("href") || "";
    if (!raw || raw.startsWith("#") || link.hasAttribute("download")) return;
    let url;
    try {
      url = new URL(link.href, window.location.href);
    } catch {
      return;
    }
    if (url.origin !== window.location.origin) return;
    if (/\.[a-z0-9]{2,5}$/i.test(url.pathname) && !url.pathname.endsWith(".html")) return;
    let changed = false;
    params.forEach(([key, value]) => {
      if (!url.searchParams.has(key)) {
        url.searchParams.set(key, value);
        changed = true;
      }
    });
    if (changed) link.href = url.toString();
  }

  function preserveAttributionParams() {
    const params = Object.entries(urlTouch());
    if (params.length > 0) {
      document.querySelectorAll("a[href]").forEach((link) => carryParamsToInternalLink(link, params));
      // Enlaces que se creen después (menús, componentes dinámicos): se completan al hacer clic.
      if (!window.tdLinkCarryBound) {
        window.tdLinkCarryBound = true;
        document.addEventListener("click", (event) => {
          const link = event.target instanceof Element ? event.target.closest("a[href]") : null;
          if (link) carryParamsToInternalLink(link, Object.entries(urlTouch()));
        }, true);
      }
    }

    const touch = activeTouch();
    const attributionEntries = Object.entries(touch).filter(([key]) => attributionFields.includes(key));
    if (attributionEntries.length === 0) return;

    document.querySelectorAll(bookingUrls.map((url) => `a[href^="${url}"]`).join(", ")).forEach((link) => {
      if (!(link instanceof HTMLAnchorElement)) return;
      const url = new URL(link.href);
      attributionEntries.forEach(([key, value]) => {
        if (!url.searchParams.has(key)) url.searchParams.set(key, value);
      });
      link.href = url.toString();
    });

    // WhatsApp no admite parámetros: se añade al mensaje un código corto, visible y editable por quien escribe,
    // con el formato (ref: <utm_source>/<utm_campaign>[/<utm_content>]). Sin utm_source no se añade.
    if (!touch.utm_source) return;
    const code = [touch.utm_source, touch.utm_campaign || touch.utm_medium, touch.utm_content].filter(Boolean).join("/").replace(/[^\w/.-]/g, "").slice(0, 60);
    document.querySelectorAll('a[href*="wa.me/"]').forEach((link) => {
      if (!(link instanceof HTMLAnchorElement) || link.dataset.refCode) return;
      const url = new URL(link.href);
      const text = url.searchParams.get("text");
      if (!text) return;
      url.searchParams.set("text", `${text} (ref: ${code})`);
      link.href = url.toString();
      link.dataset.refCode = code;
    });
  }

  function loadMetaPixel() {
    if (!pixelId || window.fbq) return;
    const fbq = (window.fbq = function () {
      fbq.callMethod ? fbq.callMethod.apply(fbq, arguments) : fbq.queue.push(arguments);
    });
    if (!window._fbq) window._fbq = fbq;
    fbq.push = fbq;
    fbq.loaded = true;
    fbq.version = "2.0";
    fbq.queue = [];
    const script = document.createElement("script");
    script.async = true;
    script.src = "https://connect.facebook.net/en_US/fbevents.js";
    document.head.appendChild(script);
    fbq("init", pixelId);
    fbq("track", "PageView");
  }

  function readConsent() {
    try {
      const raw = localStorage.getItem(consentKey);
      if (!raw) return null;
      // Los valores de la primera versión ("all", "necessary", "reject") no incluían el chat: se vuelve a preguntar.
      if (!raw.startsWith("{")) return null;
      const consent = JSON.parse(raw);
      if (!consent || consent.version !== consentVersion) return null;
      if (Date.now() - Number(consent.date || 0) > consentMaxAgeMs) return null;
      return consent;
    } catch {
      return null;
    }
  }

  function saveConsent(analytics, chat, marketing) {
    const consent = { analytics, chat, marketing, date: Date.now(), version: consentVersion };
    try {
      localStorage.setItem(consentKey, JSON.stringify(consent));
    } catch {
      // Sin almacenamiento disponible: se aplica solo a esta visita.
    }
    return consent;
  }

  // Borra cookies del dominio actual y del dominio raíz. Con Consent Mode, gtag no las escribe sin consentimiento;
  // esto solo limpia las que hubiera de una decisión anterior (p. ej. al retirar el consentimiento).
  function deleteCookies(isTarget) {
    const domain = window.location.hostname.replace(/^www\./, "");
    document.cookie.split(";").forEach((cookie) => {
      const name = cookie.split("=")[0].trim();
      if (!isTarget(name)) return;
      ["", `; domain=${domain}`, `; domain=.${domain}`].forEach((scope) => {
        document.cookie = `${name}=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/${scope}`;
      });
    });
  }

  function disableAnalytics() {
    deleteCookies((name) => name === "_ga" || name.startsWith("_ga_") || name === "_gid" || name.startsWith("_gat"));
  }

  function disableMarketing() {
    // Cookies de Meta (_fbp, _fbc) y de Google Ads (_gcl_*, _gac_*).
    deleteCookies((name) => name === "_fbp" || name === "_fbc" || name.startsWith("_gcl_") || name.startsWith("_gac_"));
  }

  // Consent Mode v2: el <head> (BaseLayout) ya declaró todo denegado y aplicó la decisión guardada. Aquí solo se
  // actualiza el estado de Google cuando el visitante decide o cambia de opinión (fromStorage = decisión ya aplicada).
  function applyConsent(consent, previous, fromStorage) {
    window.tdConsent = consent;
    if (!fromStorage) window.tdGoogleConsent?.(consent);
    captureAttribution();
    applyAttributionToLinks();
    if (!consent.analytics) disableAnalytics();
    if (consent.marketing) {
      loadMetaPixel();
    } else {
      disableMarketing();
    }
    window.dispatchEvent(new CustomEvent("td:consent", { detail: consent }));
    // Retirar un consentimiento ya dado exige recargar para descargar los scripts de terceros.
    if (previous && ((previous.analytics && !consent.analytics) || (previous.chat && !consent.chat) || (previous.marketing && !consent.marketing))) {
      window.location.reload();
    }
  }

  function syncSettingsForm(consent) {
    if (!(settingsForm instanceof HTMLFormElement)) return;
    settingsForm.elements.namedItem("analytics").checked = Boolean(consent?.analytics);
    settingsForm.elements.namedItem("chat").checked = Boolean(consent?.chat);
    const marketingInput = settingsForm.elements.namedItem("marketing");
    if (marketingInput) marketingInput.checked = Boolean(consent?.marketing);
  }

  function openBanner(showSettings) {
    if (!(banner instanceof HTMLElement)) return;
    banner.hidden = false;
    syncSettingsForm(readConsent());
    if (settingsForm instanceof HTMLElement) settingsForm.hidden = !showSettings;
    banner.querySelector("[data-cookie-open-settings]")?.toggleAttribute("hidden", showSettings);
    banner.querySelector('[data-cookie-choice="save"]')?.toggleAttribute("hidden", !showSettings);
  }

  const currentConsent = readConsent();
  if (currentConsent) {
    applyConsent(currentConsent, undefined, true);
  } else {
    applyAttributionToLinks();
    openBanner(false);
  }

  banner?.querySelector("[data-cookie-open-settings]")?.addEventListener("click", () => openBanner(true));
  document.querySelectorAll("[data-cookie-settings-open]").forEach((trigger) => {
    trigger.addEventListener("click", (event) => {
      event.preventDefault();
      openBanner(true);
    });
  });

  document.querySelectorAll("[data-cookie-choice]").forEach((button) => {
    button.addEventListener("click", () => {
      const choice = button.getAttribute("data-cookie-choice");
      const previous = readConsent();
      let analytics = false;
      let chat = false;
      let marketing = false;
      if (choice === "all") {
        analytics = true;
        chat = true;
        marketing = true;
      } else if (choice === "save" && settingsForm instanceof HTMLFormElement) {
        analytics = settingsForm.elements.namedItem("analytics").checked;
        chat = settingsForm.elements.namedItem("chat").checked;
        marketing = Boolean(settingsForm.elements.namedItem("marketing")?.checked);
      }
      const consent = saveConsent(analytics, chat, marketing);
      if (banner instanceof HTMLElement) banner.hidden = true;
      applyConsent(consent, previous);
      trackEvent(analytics ? "aceptacion_cookies" : "rechazo_cookies", { choice, analytics, chat, marketing });
    });
  });

  document.addEventListener("click", (event) => {
    const target = event.target instanceof Element ? event.target.closest("a, button") : null;
    if (target instanceof HTMLElement) {
      const eventName = getClickEventName(target);
      if (eventName) trackEvent(eventName, getClickEventParams(target));
    }
  });

</script>

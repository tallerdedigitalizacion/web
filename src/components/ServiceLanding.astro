---
import BaseLayout from "@/layouts/BaseLayout.astro";
import CaseStory from "@/components/CaseStory.astro";
import PortfolioStory from "@/components/PortfolioStory.astro";
import { siteConfig } from "@/config/site";
import ReviewsCarousel from "@/components/ReviewsCarousel.astro";
import LeadMagnetQuiz from "@/components/LeadMagnetQuiz.astro";
import { quizIdForPath } from "@/data/leadMagnets";

export interface ServiceSection {
  id: string;
  eyebrow: string;
  heading: string;
  variant: "tag" | "check" | "steps";
  // Párrafo opcional bajo el título de la sección.
  intro?: string;
  items?: string[];
  // Solo para variant "steps": pasos numerados con título y texto.
  steps?: [string, string][];
}

interface Props {
  lang?: "es" | "en";
  title: string;
  description: string;
  slug: string;
  schemaDescription: string;
  schemaAreaServed?: string[];
  eyebrow: string;
  h1: string;
  subtitleParagraphs: string[];
  sections: ServiceSection[];
  finalCtaHeading: string;
  faqs?: [string, string][];
  leadMagnetNav?: [string, string];
}

const {
  lang = "es",
  title,
  description,
  slug,
  schemaDescription,
  schemaAreaServed,
  eyebrow,
  h1,
  subtitleParagraphs,
  sections,
  finalCtaHeading,
  faqs,
  leadMagnetNav,
} = Astro.props as Props;

const isEnglish = lang === "en";
const quizId = Astro.slots.has("lead-magnet") ? undefined : quizIdForPath(slug);
const googleReviewsUrl = "https://maps.app.goo.gl/iJYaupqoL8usLB6X7";


const defaultFaqs: [string, string][] = isEnglish
  ? [
      ["Does this mean replacing all my current tools?", "Not necessarily. We first review what you already have and only change what actually needs it."],
      ["How long does the project take?", "It depends on scope. We confirm timing after an initial call."],
      ["How much does it cost?", "Scope and price are adjusted to the complexity of the business. No commitment."],
    ]
  : [
      ["¿Esto significa cambiar todas mis herramientas actuales?", "No necesariamente. Revisamos primero lo que ya tiene y solo cambiamos lo que haga falta."],
      ["¿Cuánto dura el proyecto?", "Depende del alcance. Se lo confirmamos tras una primera llamada."],
      ["¿Cuánto cuesta?", "El alcance y el precio se ajustan a la complejidad de la empresa. Sin compromiso."],
    ];
const resolvedFaqs = faqs && faqs.length > 0 ? faqs : defaultFaqs;

const whyMeLabel = isEnglish ? "Why me" : "Por qué yo";
const faqLabel = "FAQ";

const navItems = [
  ...sections.map((section) => [section.eyebrow, `#${section.id}`]),
  ...(leadMagnetNav ? [leadMagnetNav] : []),
  ...(quizId ? [[isEnglish ? "Self-assessment" : "Autoevaluación", isEnglish ? "#self-assessment" : "#autoevaluacion"]] : []),
  [whyMeLabel, "#por-que-yo"],
  [faqLabel, "#faq"],
];

const bookingUrl = isEnglish ? siteConfig.bookingUrlEn : siteConfig.bookingUrl;
const bookingLabel = isEnglish ? "Book a free call" : "Reservar llamada gratuita";
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath={slug}
  headerNavItems={navItems}
  headerBookingEvent="reservar_click"
  lang={lang}
  showChatbase={!isEnglish}
  schemaDescription={schemaDescription}
  schemaAreaServed={schemaAreaServed}
>
  <section class="hero">
    <div class="hero-content">
      <span class="eyebrow">{eyebrow}</span>
      <h1>{h1}</h1>
      {subtitleParagraphs.map((paragraph, index) => (
        index === 0 ? <p class="hero-subtitle">{paragraph}</p> : <p>{paragraph}</p>
      ))}
      <div class="hero-actions">
        <a class="btn btn-primary" data-event="reservar_click" data-preserve-utm href={bookingUrl} target="_blank" rel="noreferrer">{bookingLabel}</a>
      </div>
    </div>
  </section>

  {sections.map((section, index) => (
    <section id={section.id} class={`section ${index % 2 === 0 ? "section-accent" : ""}`}>
      <div class="section-head">
        <span class="eyebrow">{section.eyebrow}</span>
        <h2>{section.heading}</h2>
        {section.intro && <p>{section.intro}</p>}
      </div>
      {section.variant === "steps" ? (
        <div class={section.steps?.length === 4 ? "steps steps-4" : "steps"}>
          {section.steps?.map(([name, text], index) => (
            <article>
              <span class="step-number">{index + 1}</span>
              <h3>{name}</h3>
              <p>{text}</p>
            </article>
          ))}
        </div>
      ) : section.variant === "tag" ? (
        <div class="tag-grid">
          {section.items?.map((item) => <span>{item}</span>)}
        </div>
      ) : (
        <ul class="check-list">
          {section.items?.map((item) => <li>{item}</li>)}
        </ul>
      )}
    </section>
  ))}

  <slot name="lead-magnet" />
  {quizId && <LeadMagnetQuiz id={quizId} lang={lang} />}

  {!isEnglish && <CaseStory path={slug} />}
  {!isEnglish && <PortfolioStory path={slug} />}

  <section id="por-que-yo" class="section">
    <div class="section-head">
      <span class="eyebrow">{whyMeLabel}</span>
      <h2>{isEnglish ? "A technical person looking directly at the problem." : "Una persona técnica mirando el problema de frente."}</h2>
      <p>
        {isEnglish ? `${siteConfig.experienceYears} years building and optimizing software. ` : `${siteConfig.experienceYears} años desarrollando y optimizando software. `}
        <a class="google-review-link" href={googleReviewsUrl} target="_blank" rel="noreferrer">
          <svg class="google-mark" aria-hidden="true" viewBox="0 0 24 24" width="18" height="18">
            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.76h3.56c2.08-1.92 3.28-4.74 3.28-8.09Z"/>
            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.56-2.76c-.98.66-2.24 1.06-3.72 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84A11 11 0 0 0 12 23Z"/>
            <path fill="#FBBC05" d="M5.84 14.11a6.61 6.61 0 0 1 0-4.22V7.05H2.18a11 11 0 0 0 0 9.9l3.66-2.84Z"/>
            <path fill="#EA4335" d="M12 5.36c1.62 0 3.06.56 4.21 1.64l3.15-3.15A10.56 10.56 0 0 0 12 1 11 11 0 0 0 2.18 7.05l3.66 2.84C6.71 7.29 9.14 5.36 12 5.36Z"/>
          </svg>
          {isEnglish ? "10+ Google reviews" : "+10 reseñas en Google"}
        </a>
        {isEnglish ? " and 1,000+ followers on LinkedIn. You talk to the person doing the technical work, not an agency handoff." : " y +1.000 seguidores en LinkedIn. Una persona real que te atiende, no una agencia que te deriva a un becario."}
      </p>
    </div>
    <ReviewsCarousel lang={lang} />
  </section>

  <section id="faq" class="section">
    <div class="section-head">
      <span class="eyebrow">{isEnglish ? "FAQ" : "Preguntas frecuentes"}</span>
      <h2>{isEnglish ? "Common questions before getting started." : "Dudas habituales antes de empezar."}</h2>
    </div>
    <div class="faq-list">
      {resolvedFaqs.map(([question, answer]) => (
        <details>
          <summary>{question}</summary>
          <p>{answer}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="section final-cta">
    <h2>{finalCtaHeading}</h2>
    <div class="hero-actions">
      <a class="btn btn-primary" data-event="reservar_click" data-preserve-utm href={bookingUrl} target="_blank" rel="noreferrer">{bookingLabel}</a>
    </div>
  </section>
</BaseLayout>

<script>
  import { BOOKING_URLS } from "@/config/booking";

  const params = new URLSearchParams(window.location.search);
  const utmEntries = [...params.entries()].filter(([key]) => key.toLowerCase().startsWith("utm_"));

  if (utmEntries.length > 0) {
    document.querySelectorAll(`[data-preserve-utm], ${BOOKING_URLS.map((url) => `a[href^="${url}"]`).join(", ")}`).forEach((link) => {
      if (!(link instanceof HTMLAnchorElement)) return;
      const url = new URL(link.href);
      utmEntries.forEach(([key, value]) => {
        if (!url.searchParams.has(key)) url.searchParams.set(key, value);
      });
      link.href = url.toString();
    });
  }

  document.querySelectorAll(".faq-list details").forEach((item) => {
    item.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      if (target.closest("summary")) return;
      item.open = !item.open;
    });
  });
</script>

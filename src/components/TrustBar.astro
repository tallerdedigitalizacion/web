---
import { siteConfig } from "@/config/site";

const { lang = "es" } = Astro.props;
const isEnglish = lang === "en";
const items = isEnglish
  ? [
      [`${siteConfig.experienceYearsEn} years`, "solving technical problems"],
      ["Hundreds", "of clients served"],
      ["5.0 ★", "in Google reviews"],
      ["Certified", "as a software developer"],
    ]
  : [
      [`${siteConfig.experienceYears} años`, "resolviendo problemas técnicos"],
      ["Cientos", "de clientes atendidos"],
      ["5,0 ★", "en reseñas de Google"],
      ["Certificado", "como desarrollador de software"],
    ];
---

<section class="section trust-bar" aria-label={isEnglish ? "Why trust Taller de Digitalización" : "Por qué confiar en Taller de Digitalización"}>
  <div class="trust-grid">
    {items.map(([value, label]) => (
      <div>
        <strong>{value}</strong>
        <span>{label}</span>
      </div>
    ))}
  </div>
  <div class="trust-remote">
    <div>
      <strong>{isEnglish ? "Already a client and need remote support?" : "¿Ya eres cliente y necesitas soporte remoto?"}</strong>
      <span>{isEnglish ? "Download AnyDesk, open it and tell me the number shown on screen." : "Descarga AnyDesk, ábrelo y dime el número que aparece en pantalla."}</span>
    </div>
    <a class="btn btn-secondary btn-small" data-event="descarga_anydesk" href={isEnglish ? siteConfig.anydeskUrlEn : siteConfig.anydeskUrl} target="_blank" rel="noreferrer">{isEnglish ? "Download AnyDesk" : "Descargar AnyDesk"}</a>
    {!isEnglish && <a class="btn btn-secondary btn-small" href="/soporte-remoto/">Cómo funciona</a>}
  </div>
</section>
